#pragma once

struct FTerrainParams
{
	float3 RotAxis;
	float RotAngle;
    float3 PlanePos;
	float VerticalNoiseOffset;
    float MinNoiseScale;
    uint NumOctaves;
    float Frequency;
    float Lacunarity;
    float Amplitude;
    float Persistence;
    float Inflation;
    float InflationGain;
	float SampleSmoothing;
    float UnionSmoothing;
    float ClippingSmoothing;
	bool bSimplex;
};

// [CREDITS] https://www.shadertoy.com/view/sfXXzX
uint VMulU32U24( uint a, uint b ) { return (a & 0x00ffffffu) * (b & 0x00ffffffu); }
float SimpleHash32V3( uint3 Seed )
{
	uint sx = (0xb543c3a6u ^ Seed.x) + Seed.z;
	uint sy = (0x526f94e2u ^ Seed.y) + sx;
	uint sz = (0x74743c1bu ^ Seed.z) + sy;
	uint l0 = VMulU32U24( sx, sy );
	uint l1 = VMulU32U24( l0, sz );
	uint u0 = VMulU32U24( sz >> 16, l1 );
	uint m0 = l1 ^ (u0 >> 16);
	uint m1 = m0 ^ u0;

	// [0, 1]
	return (float)m1 / (float)0xFFFFFFFFu;
}

// [CREDITS] https://iquilezles.org/articles/fbmsdf/
float SampleGridSpheres( float3 Pos, float MaxDiameter, float MinNoiseScale, float SampleSmoothing )
{
	// Find the lowest bound of the "cell" (of local unit scale) we reside in
	const int3 CellMin = floor( Pos );

	// The sphere SDFs will be evaluated in local space (using the '(x, y, z)' offset below)
	// To calculate the distance to the origin of the sample spheres,
	// we need to calculate the position in the space local to the cell
	const float3 CellSpacePos = frac( Pos );

	// Sample the 8 corners of our cell
	float Dist = 1e30;
	[unroll] for (uint z = 0; z < 2; ++z) {
	[unroll] for (uint y = 0; y < 2; ++y) {
	[unroll] for (uint x = 0; x < 2; ++x) 
	{
		// Pick the radius based on a hash
		const int3 CornerOffset = int3( x, y, z );
		const int3 CellCorner = CellMin + CornerOffset;
		const uint3 Seed = uint3( asuint( CellCorner.x ), asuint( CellCorner.y ), asuint( CellCorner.z ) );
		const float NoiseScale = (SimpleHash32V3( Seed ) * (1.0 - MinNoiseScale)) + MinNoiseScale; // [MinNoiseScale, 1]
		const float Diameter = MaxDiameter * NoiseScale;
		const float Radius = Diameter / 2.0;

		// Evaluate the sphere's SDF
		const float SphereOriginDist = length( CellSpacePos - CornerOffset );
		const float SphereDist = SphereOriginDist - Radius;
				
		// Combine sphere SDFs
		Dist = OpSmoothUnion( Dist, SphereDist, SampleSmoothing );
	}}}
	return Dist;
}

// [CREDITS] Adapted from https://github.com/KdotJPG/OpenSimplex2/blob/master/hlsl/OpenSimplex2.hlsl
float4 Permute( float4 t ) { return t * (t * 34.0 + 133.0); }
float4 Mod( float4 x, float4 y ) { return x - y * floor( x / y ); }
float SampleSimplexSpheres( float3 Pos, float MaxDiameter, float MinNoiseScale, float SampleSmoothing )
{	
	// Calculate the vertices and the distances to them
	const float3 Vert1 = round( Pos );
	const float3 Dist1 = Pos - Vert1;
	const float3 AbsDist1 = abs( Dist1 );
	const float3 Dir1 = step( max( AbsDist1.yzx, AbsDist1.zxy ), AbsDist1 );
	const float3 Vert2 = Vert1 + (Dir1 * sign( Dist1 ));
	const float3 Dist2 = Pos - Vert2;
	// Second half-lattice
	const float3 Pos2 = Pos + 144.5;
	const float3 Vert3 = round( Pos2 );
	const float3 Dist3 = Pos2 - Vert3;
	const float3 AbsDist2 = abs( Dist3 );
	const float3 Dir2 = step( max( AbsDist2.yzx, AbsDist2.zxy ), AbsDist2 );
	const float3 Vert4 = Vert3 + (Dir2 * sign( Dist3 ));
	const float3 Dist4 = Pos2 - Vert4;
	// [0, 47]
	float4 Hashes = Permute( Mod( float4( Vert1.x, Vert2.x, Vert3.x, Vert4.x ), 289.0 ) );
	Hashes = Permute( Mod( Hashes + float4( Vert1.y, Vert2.y, Vert3.y, Vert4.y ), 289.0 ) );
	Hashes = Mod( Permute( Mod( Hashes + float4( Vert1.z, Vert2.z, Vert3.z, Vert4.z ), 289.0 ) ), 48.0 );
	
	// Calculate the radii
	const float4 NoiseScale = ((Hashes / 47.0) * (1.0 - MinNoiseScale)) + MinNoiseScale; // [MinNoiseScale, 1]
	const float4 Diameters = MaxDiameter * NoiseScale;
	const float4 Radii = Diameters / 2.0;
	
	// Combine sphere SDFs
	return OpSmoothUnion( OpSmoothUnion( OpSmoothUnion( length( Dist1 ) - Radii.x,
														length( Dist2 ) - Radii.y, SampleSmoothing ),
														length( Dist3 ) - Radii.z, SampleSmoothing ),
														length( Dist4 ) - Radii.w, SampleSmoothing );
}

float3x3 GetRowRotMatrix( float3 RotAxis, float RotAngle )
{
	const float Cos = cos( RotAngle );
	const float CosComp = 1 - Cos;
	const float3 RotationDiagonal = (CosComp * RotAxis * RotAxis) + Cos;
	const float CosCompXY = CosComp * RotAxis.x * RotAxis.y;
	const float CosCompXZ = CosComp * RotAxis.x * RotAxis.z;
	const float CosCompYZ = CosComp * RotAxis.y * RotAxis.z;
	const float3 Sins = sin( RotAngle ) * RotAxis;
	return float3x3( RotationDiagonal.x, CosCompXY + Sins.z, CosCompXZ - Sins.y,
					 CosCompXY - Sins.z, RotationDiagonal.y, CosCompYZ + Sins.x,
					 CosCompXZ + Sins.y, CosCompYZ - Sins.x, RotationDiagonal.z );
}

namespace DistFn
{
	// Calculating the maximum (theoretical) height of the terrain
	// Overestimates the height if 'InflationGain * Persistence > 1'
	//
	// Calculate the initial inflation and the rate at which it changes:
	// 'Amplitude0 = (Amplitude / Frequency) * (bSimplex ? sqrt(3)/2 : 1)'
	// 'Inflation0 = Inflation * (VerticalNoiseOffset + 0.5) * Amplitude0'
	// 'Gain = InflationGain * Persistence'
	//
	// The inflation for octave 'i' is 'Inflation0 * Gain^i'
	// We can sum the octaves' inflation distances to get the total inflation:
	// 'InflationN = Inflation0 * (Gain^0 + Gain^1 + ... + Gain^(N-1))'
	// 'InflationN = Inflation0 * (1 + Gain^1 + ... + Gain^(N-1))'
	//
	// Analytically calculate the sum:
	// 'GainN = 1 + Gain^1 + ... + Gain^(N-1)'
	// (Gain != 1) 'GainN = (1 - Gain^N) / (1 - Gain)'
	// (Gain == 1) 'GainN = N'
	//
	// The maximum height of the terrain is 'PlanePos.z + (Inflation0 * GainN)'
	float FBM( float3 Pos, FTerrainParams Params, float PixelSize = 0.0 )
    {
		// Sample from a base (plane) SDF to get our initial distance field
		// The octaves will subsequently add noise to said field
		float Dist = Pos.z - Params.PlanePos.z;

		// Changing the frequency should only scale the noise, not modify it
		// Thus, we must make the amplitude relative to the frequency (and move it into world space)
		// For (e.g.) half the frequency (double the space for a sphere), we have twice the diameter
		Params.Amplitude /= Params.Frequency;
		// The distance between grid points is 1, but for Simplex noise the distance between the vertices is smaller,
		// so we have to scale the amplitude by said distance to compensate, if we're using Simplex noise
		if (Params.bSimplex) { Params.Amplitude *= sqrt( 3 ) / 2.0; }

		// Move the sample position into the coordinate space of the plane
		// We do this so the noise is stable when moving the plane
		Pos -= Params.PlanePos;
		
		// Offset the noise vertically (the only axis on which it is not possible through 'PlanePos')
		// The offset ranges [-0.5, 0.5], relative to the diameter for the first octave of noise
		Pos.z -= Params.VerticalNoiseOffset * Params.Amplitude;
		// The inflation ranges [0, 1] and should map to the minimum and maximum height of the first octave
		// Adjust for/multiply by the percentage of the sphere above the terrain
		Params.Inflation *= Params.VerticalNoiseOffset + 0.5;

		// The sample position is scaled by 'Frequency * Lacunarity^i'
		// Apply the frequency scaling, as it doesn't depend on the octave
		Pos *= Params.Frequency;

		// Instead of directly applying the lacunarity,
		// we integrate it into a matrix that also has rotation,
		// to avoid patterns in our noise
		const float3x3 RotMatrix = GetRowRotMatrix( Params.RotAxis, Params.RotAngle );
		const float3x3 LacunarityMatrix = RotMatrix * Params.Lacunarity;

		// Apply a layer of noise for each octave
		[loop] for (uint i = 0; i < Params.NumOctaves; ++i)
		{
			// Band-limit the samples
			// Attempting to render detail smaller than a pixel introduces aliasing,
			// so stop adding octaves once the sphere diameter is smaller than a pixel to avoid artefacts
			if (Params.Amplitude < PixelSize) { break; }

			// The local-space (maximum) sample diameter for this octave
			const float LocalDiameter = Params.Amplitude * Params.Frequency;

			// We sample from an infinite grid of spheres, but only want those closest to the terrain to add to it
			// Our inflation distance should therefore not be any higher than the maximum diameter of a sample sphere
			// The base inflation ranges [0, 1], relative to the sphere diameter
			// Therefore we multiply said base by this octave's (maximum) sphere diameter
			const float Inflation = Params.Inflation * Params.Amplitude;
			// We want the smoothing factors/distances to apply similar smoothing regardless of the sphere diameter
			// Therefore we multiply a base value by this octave's maximum sphere diameter
			const float ClippingSmoothing = Params.ClippingSmoothing * Params.Amplitude;
			const float UnionSmoothing = Params.UnionSmoothing * Params.Amplitude;
			// 'SampleSmoothing' is used in local space, so multiply it by the local diameter instead
			const float SampleSmoothing = Params.SampleSmoothing * LocalDiameter;
			
            // We simulate an infinite grid of spheres (through domain repetition)
			// There is a sphere on every unit boundary in local space
			// The local distance is scaled by 'Frequency * Lacunarity^i'
			// The local unit scale has an inverse relationship with the frequency
			// The higher the frequency, the smaller the local unit scale, resulting in more spheres per world-space unit
			const float LocalSampleDist = Params.bSimplex
											  ? SampleSimplexSpheres( Pos, LocalDiameter, Params.MinNoiseScale, SampleSmoothing )
											  : SampleGridSpheres( Pos, LocalDiameter, Params.MinNoiseScale, SampleSmoothing );
			// Convert the distance to world space
			const float SampleDist = LocalSampleDist / Params.Frequency;

			// We cannot inflate the current distance field by a factor/through multiplication,
			// since the result wouldn't be a true SDF, as the gradient's magnitude wouldn't be 1 at all points
			// Thus, we must subtract the distance by a set amount as a way of inflating the SDF
			const float InflatedDist = Dist - Inflation;
			// Calculate the distance field of the intersection between the sampled distance and the inflated terrain
			// We use this to mask out any noise not within distance of the terrain (as per the previous octaves)
			const float ClippedDist = OpSmoothIntersect( InflatedDist, SampleDist, ClippingSmoothing );
			// Add the (masked-out) layer of noise onto our current terrain distance field
			// We do this through by taking the minimum, as to not disturb the gradient's magnitude
			Dist = OpSmoothUnion( Dist, ClippedDist, UnionSmoothing );

			// The sample position is scaled by 'Frequency * Lacunarity^i'
			Pos = mul( Pos, LacunarityMatrix );
			// Our sampled distance fields won't be true SDFs, 
			// as scaling causes the gradient's magnitude to no longer be 1 at all points
			// We keep track of the current scaling (frequency), so we can undo it after sampling
			Params.Frequency *= Params.Lacunarity;
			// The amplitude is the maximum diameter of a sample sphere
			Params.Amplitude *= Params.Persistence;
			// Subsequent octaves have more frequent noise/spheres, so we need to adjust our clipping mask size
			Params.Inflation *= Params.InflationGain;
			
			// Visualizations (move above octave setup)
			continue;
			if (i == Params.NumOctaves - 1) { return SampleDist; } // Visualize the last set of spheres
			if (i == Params.NumOctaves - 1) { return ClippedDist; } // Visualize the last layer of noise
			if (i == Params.NumOctaves - 1) { return InflatedDist; } // Visualize the second to last layer inflated
			// The viewport and render resolutions need to be the same to make the band-limiting visualization work
			if (Params.Amplitude < PixelSize * 200.0) { return ClippedDist; } // Visualize the band-limiting
		}
		return Dist;
    }
}