#pragma once

struct FTerrainParams
{
	float3 RotAxis;
	float RotAngle;
    float3 PlanePos;
    uint NumOctaves;
    float Frequency;
    float Lacunarity;
    float Amplitude;
    float Persistence;
    float Inflation;
    float InflationGain;
    float UnionSmoothing;
    float ClippingSmoothing;
    float MaxRadiusVariance;
};

// [CREDITS] https://www.shadertoy.com/view/sfXXzX
uint VMulU32U24( uint a, uint b ) { return (a & 0x00ffffffu) * (b & 0x00ffffffu); }
float SimpleHash32V3( uint3 Seed )
{
	uint sx = (0xb543c3a6u ^ Seed.x) + Seed.z;
	uint sy = (0x526f94e2u ^ Seed.y) + sx;
	uint sz = (0x74743c1bu ^ Seed.z) + sy;
	uint l0 = VMulU32U24( sx, sy );
	uint l1 = VMulU32U24( l0, sz );
	uint u0 = VMulU32U24( sz >> 16, l1 );
	uint m0 = l1 ^ (u0 >> 16);
	uint m1 = m0 ^ u0;

	// [0, 1]
	return (float)m1 / (float)0xFFFFFFFFu;
}

// TODO: make sure this returns a distance such that amplitude corresponds to real max sphere height idkkk
// TODO:
// TODO: I think max amplitude can be 1.0, since otherwise it will go past the origin of other spheres
// TODO: but then make amplitude the MAX (instead of average) (rename 'MaxRadiusVariance')
float SampleHashSphere( int3 CellPos, float3 PosFract, int3 CornerOffset )
{
	// TODO: radius
	// TODO: avg radius
	// TODO: but also the range (e.g. [0.8xAvg, 1.2xAvg]
	// Decide the radius based on a hash
	const int3 CornerCell = CellPos + CornerOffset;
	const uint3 Seed = uint3( asuint( CornerCell.x ), asuint( CornerCell.y ), asuint( CornerCell.z ) );
	const float Radius = 0.5 * SimpleHash32V3( Seed );

	//
	return length( PosFract - CornerOffset ) - Radius;
}

// [CREDITS] https://iquilezles.org/articles/fbmsdf/
float SampleHashSphere8( float3 Pos )
{	
	// TODO: can the repetition somehow not have the spheres on an exact grid?

	const int3 CellPos = floor( Pos );
	const float3 PosFract = frac( Pos );
	return min( min( min( SampleHashSphere( CellPos, PosFract, int3( 0, 0, 0) ),
						  SampleHashSphere( CellPos, PosFract, int3( 0, 0, 1) ) ),
					 min( SampleHashSphere( CellPos, PosFract, int3( 0, 1, 0) ),
						  SampleHashSphere( CellPos, PosFract, int3( 0, 1, 1) ) ) ),
				min( min( SampleHashSphere( CellPos, PosFract, int3( 1, 0, 0) ),
						  SampleHashSphere( CellPos, PosFract, int3( 1, 0, 1) ) ),
					 min( SampleHashSphere( CellPos, PosFract, int3( 1, 1, 0) ),
						  SampleHashSphere( CellPos, PosFract, int3( 1, 1, 1) ) ) ) );
}

float3x3 GetRowRotMatrix( float3 RotAxis, float RotAngle )
{
	const float Cos = cos( RotAngle );
	const float CosComp = 1 - Cos;
	const float3 RotationDiagonal = (CosComp * RotAxis * RotAxis) + Cos;
	const float CosCompXY = CosComp * RotAxis.x * RotAxis.y;
	const float CosCompXZ = CosComp * RotAxis.x * RotAxis.z;
	const float CosCompYZ = CosComp * RotAxis.y * RotAxis.z;
	const float3 Sins = sin( RotAngle ) * RotAxis;
	return float3x3( RotationDiagonal.x, CosCompXY + Sins.z, CosCompXZ - Sins.y,
					 CosCompXY - Sins.z, RotationDiagonal.y, CosCompYZ + Sins.x,
					 CosCompXZ + Sins.y, CosCompYZ - Sins.x, RotationDiagonal.z );
}

namespace DistFn
{
	float FBM( float3 Pos, FTerrainParams Params )
    {
		// TODO: I would like for the Frequency to not change any other parts of the result
		// TODO: e.g. the amplitude 
		//Params.Amplitude /= Params.Frequency;
		// TODO: that seems to work, but only for the first octave

		// Sample from a base (plane) SDF to get our initial distance field
		// The octaves will subsequently add noise to said field
		float Dist = Pos.z - Params.PlanePos.z;

		// TODO: try to make it so that regardless of PlaneZ and Amplitude,
		// TODO: - Octave 1 spheres are sliced exactly in half by the plane
		// TODO: - inflation = 0.5 results in EXACTLY 1 sphere fully showing
		// TODO: currently it only works for (e.g.) Freq=1 & Amp=500
		// TODO: do note that creases appear if 'Persistence > 1/Lacunarity' (because radius > half cell size)
		// TODO: I don't think this would happen if we sampled 8 spheres smoothly, maybe?
		// TODO: or maybe amplitude could be relative to the cell size (maybe that also solves the second TODO in this fn)
		// Move the sample position into the coordinate space of the plane
		// We do this so the noise is stable when moving the plane
		Pos -= Params.PlanePos;

		// The sample position is scaled by 'Frequency * Lacunarity^i'
		// Apply the frequency scaling, as it doesn't depend on the octave
		Pos *= Params.Frequency;
		// Our sampled distance fields won't be true SDFs, 
		// as scaling causes the gradient's magnitude to no longer be 1 at all points
		// We keep track of the current scaling, so we can undo it after sampling
		float LocalScale = Params.Frequency;
		// Instead of directly applying the lacunarity,
		// we integrate it into a matrix that also has rotation,
		// to avoid patterns in our noise
		const float3x3 RotMatrix = GetRowRotMatrix( Params.RotAxis, Params.RotAngle );
		const float3x3 LacunarityMatrix = RotMatrix * Params.Lacunarity;

		// Apply a layer of noise for each octave
		for (uint i = 0; i < Params.NumOctaves; ++i)
		{
			// We sample from an infinite grid of spheres, but only want those closest to the terrain to add to it
			// Our inflation distance should therefore not be any higher than the maximum diameter of a sample sphere
			// The base inflation ranges [0, 1], where 1 corresponds to the diameter of a sphere
			// Therefore we multiply said base by this octave's maximum sphere diameter
			const float Inflation = Params.Inflation * Params.Amplitude * 2.0;
			// We want the smoothing factors/distances to apply similar smoothing regardless of the sphere radius
			// Therefore we multiply a base value by this octave's maximum sphere radius
			const float ClippingSmoothing = Params.ClippingSmoothing * Params.Amplitude;
			// TODO: why do high values result in a crease? (try just octave 1)
			const float UnionSmoothing = Params.UnionSmoothing * Params.Amplitude;

#if 1
			// Simulate a distance field of an infinite grid of spheres (through domain repetition)
			// Sample the closest 8 spheres to determine the distance
			const float LocalPointDist = SampleHashSphere8( Pos );
			// The local distance is scaled by 'Frequency * Lacunarity^i'
			// Convert back to world-space distance
			const float PointDist = LocalPointDist / LocalScale;
			const float SphereDist = PointDist - Params.Amplitude; // TODO: still correct?
#else
			// Sample
			const float LocalPointDist = length( Pos - round( Pos ) );
			// The local distance is scaled by 'Frequency * Lacunarity^i'
			// Convert back to world-space distance
			const float PointDist = LocalPointDist / LocalScale;
			const float SphereDist = PointDist - Params.Amplitude;
#endif

			// We cannot inflate the current distance field by a factor/through multiplication,
			// since the result wouldn't be a true SDF, as the gradient's magnitude wouldn't be 1 at all points
			// Thus, we must subtract the distance by a set amount as a way of inflating the SDF
			const float InflatedDist = Dist - Inflation;
			// Calculate the distance field of the intersection between the sampled distance and the inflated terrain
			// We use this to mask out any noise not within distance of the terrain (as per the previous octaves)
			const float ClippedDist = OpSmoothIntersect( InflatedDist, SphereDist, ClippingSmoothing );
			// Add the (masked-out) layer of noise onto our current terrain distance field
			// We do this through by taking the minimum, as to not disturb the gradient's magnitude
			Dist = OpSmoothUnion( Dist, ClippedDist, UnionSmoothing );

			// TODO: if (Dist < TerrainDerivativeH) { break; }
			// TODO: also do the 'th' break from the article (break when radius < PixelSize)

			// Set up the next octave
			Pos = mul( Pos, LacunarityMatrix ); // The sample position is scaled by 'Frequency * Lacunarity^i'
			LocalScale *= Params.Lacunarity;
			Params.Amplitude *= Params.Persistence; // The amplitude is the maximum radius of a sample sphere
			Params.Inflation *= Params.InflationGain;
			
			continue;
			if (i == Params.NumOctaves - 1) { return SphereDist; } // Visualize the newest set of spheres
			if (i == Params.NumOctaves - 1) { return ClippedDist; } // Visualize the newest layer of noise
			if (i == Params.NumOctaves - 1) { return InflatedDist; } // Visualize the second to last layer inflated
		}
		return Dist;
    }
}