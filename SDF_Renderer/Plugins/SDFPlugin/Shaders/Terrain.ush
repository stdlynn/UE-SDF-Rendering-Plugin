#pragma once

struct FTerrainParams
{
    float PlaneZ;
    uint NumOctaves;
    float Frequency;
    float Lacunarity;
    float Amplitude;
    float Persistence;
    float Inflation;
    float InflationGain;
    float UnionSmoothing;
    float ClippingSmoothing;
    float MaxRadiusVariance;
};

// [CREDITS] https://www.shadertoy.com/view/sfXXzX
uint VMulU32U24( uint a, uint b ) { return (a & 0x00ffffffu) * (b & 0x00ffffffu); }
float SimpleHash32V3( uint3 Seed )
{
	uint sx = (0xb543c3a6u ^ Seed.x) + Seed.z;
	uint sy = (0x526f94e2u ^ Seed.y) + sx;
	uint sz = (0x74743c1bu ^ Seed.z) + sy;
	uint l0 = VMulU32U24( sx, sy );
	uint l1 = VMulU32U24( l0, sz );
	uint u0 = VMulU32U24( sz >> 16, l1 );
	uint m0 = l1 ^ (u0 >> 16);
	uint m1 = m0 ^ u0;

	// [0, 1]
	return (float)m1 / (float)0xFFFFFFFFu;
}

// TODO: make sure this returns a distance such that amplitude corresponds to real max sphere height idkkk
// TODO:
// TODO: I think max amplitude can be 1.0, since otherwise it will go past the origin of other spheres
// TODO: but then make amplitude the MAX (instead of average) (rename 'MaxRadiusVariance')
float SampleHashSphere( int3 CellPos, float3 PosFract, uint3 CornerOffset )
{
	// TODO: radius
	// TODO: avg radius
	// TODO: but also the range (e.g. [0.8xAvg, 1.2xAvg]
	// Decide the radius based on a hash
	const int3 CornerCell = CellPos + CornerOffset;
	const uint3 Seed = uint3( asuint( CornerCell.x ), asuint( CornerCell.y ), asuint( CornerCell.z ) );
	const float Radius = 0.5 * SimpleHash32V3( Seed );

	//
	return length( PosFract - CornerOffset ) - Radius;
}

// [CREDITS] https://iquilezles.org/articles/fbmsdf/
float SampleHashSphere8( float3 Pos )
{	
	return length( Pos - round( Pos )) - 0.5;

	const int3 CellPos = floor( Pos );
	const float3 PosFract = frac( Pos );
	return min( min( min( SampleHashSphere( CellPos, PosFract, int3( 0, 0, 0) ),
						  SampleHashSphere( CellPos, PosFract, int3( 0, 0, 1) ) ),
					 min( SampleHashSphere( CellPos, PosFract, int3( 0, 1, 0) ),
						  SampleHashSphere( CellPos, PosFract, int3( 0, 1, 1) ) ) ),
				min( min( SampleHashSphere( CellPos, PosFract, int3( 1, 0, 0) ),
						  SampleHashSphere( CellPos, PosFract, int3( 1, 0, 1) ) ),
					 min( SampleHashSphere( CellPos, PosFract, int3( 1, 1, 0) ),
						  SampleHashSphere( CellPos, PosFract, int3( 1, 1, 1) ) ) ) );
}

namespace DistFn
{
	float FBM( float3 Pos, FTerrainParams Params, float UnitScale )
    {
		// TODO: why does it scale with UnitScale
		float D = Pos.z - Params.PlaneZ;
		float Radius = Params.Amplitude; // Amplitude
		for (uint i = 0; i < Params.NumOctaves; ++i)
		{
			float SampleDist = length( Pos - RoundToUnit( Pos, 200.0, UnitScale )) - Radius;
			// TODO: The issue with the weird disappearing octave spheres is probably the inflation
			// TODO: Something with us inflating too much? Thus, we must scale by some correct value based on the amplitude
			// TODO: document this bug for ILOs
			// I think subtraction is necessary (multiplication breaks the gradient)
			float InflatedDist = D - (Params.Inflation * Radius);
			float ClippedDist = OpSmoothIntersect( InflatedDist, SampleDist, Params.ClippingSmoothing );
			D = OpSmoothUnion( D, ClippedDist, Params.UnionSmoothing );
			
			Radius *= Params.Persistence;
			//Params.Inflation *= Params.Persistence;
			Pos *= 1.2;
			//Pos -= 0.07;
		}
		return D;

		// Sample from a base SDF to get our initial field
		// The octaves will subsequently add noise to said field
        float Dist = Pos.z - Params.PlaneZ;

		float s = Params.Amplitude;
        for (uint i = 0; i < Params.NumOctaves; ++i)
        {
	        float n = SampleHashSphere8( Pos * Params.Frequency ) / UnitScale;
			n = OpSmoothIntersect(n,Dist-0.1*s,0.3*s);
			Dist = OpSmoothUnion(n,Dist      ,0.3*s);
			Params.Frequency *= Params.Lacunarity;


			Pos = mul( float3x3(  0.00,  1.60,  1.20,
								 -1.60,  0.72, -0.96,
								 -1.20, -0.96,  1.28 ), Pos );
			s = Params.Persistence*s;
        }
		return Dist;

		// Go over each octave
        for (uint i = 0; i < Params.NumOctaves; ++i)
        {
			// TODO:
			//
        	const float ClippingSmoothing = Params.ClippingSmoothing * Params.Amplitude;
			const float UnionSmoothing = Params.UnionSmoothing * Params.Amplitude;
			const float Inflation = Params.Inflation * Params.Amplitude;

        	// SDF of an infinite grid of spheres
			// Sample the closest 8 to determine the distance
			const float3 SamplePos = (Pos * Params.Frequency);// + float3( 0, Params.ClippingSmoothing, 0 ); // TODO:
            const float SampleDist = SampleHashSphere8( SamplePos ) * Params.Amplitude;

			// Inflate the current terrain distance field (from the previous octaves/base SDF)
            const float InflatedDist = Dist - Inflation;
			// Calculate the distance field of the INTERSECTION between
			// the sampled distance and the inflated SDF
			// Effectively, we mask out any noise out of distance of out terrain
            const float ClippedDist = OpSmoothIntersect( SampleDist, InflatedDist, ClippingSmoothing );
    		// Add the noise on top of the current distance field (smoothed)
            Dist = OpSmoothUnion( Dist, ClippedDist, UnionSmoothing );
			// Set the next octave's parameters
			//Pos = mul( float3x3(  0.00,  1.60,  1.20,
			//					 -1.60,  0.72, -0.96,
			//					 -1.20, -0.96,  1.28 ), Pos );
            Params.Frequency *= Params.Lacunarity;
            Params.Amplitude *= Params.Persistence;
			Params.Inflation *= Params.InflationGain;
        }
        return Dist;
    }
}