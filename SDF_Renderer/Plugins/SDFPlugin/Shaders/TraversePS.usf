float VoxSize;
float SurfaceEpsilon;
float DerivativeH;
float UnitScale;
// Terrain
float PlaneZ;
uint NumOctaves;
float Frequency;
float Lacunarity;
float Amplitude;
float Persistence;
float Inflation;
float InflationGain;
float UnionSmoothing;
float ClippingSmoothing;
float MaxRadiusVariance;

FTerrainParams GetTerrainParams()
{
    FTerrainParams Params;
    Params.PlaneZ             = PlaneZ;
    Params.NumOctaves         = NumOctaves;
    Params.Frequency          = Frequency;
    Params.Lacunarity         = Lacunarity;
    Params.Amplitude          = Amplitude;
    Params.Persistence        = Persistence;
    Params.Inflation          = Inflation;
    Params.InflationGain      = InflationGain;
    Params.UnionSmoothing     = UnionSmoothing;
    Params.ClippingSmoothing  = ClippingSmoothing;
    Params.MaxRadiusVariance  = MaxRadiusVariance;
    return Params;
}

// TODO: make this clamped
// TODO: if outside of bounds, return Diagonal? Unsure
float GetAtlasDistClamped( float3 Pos, float3 BoundsMin )
{
	const float Diagonal = GetDiagonal( VoxSize );
	const float3 UVW = WorldPosToAtlasUVW( Pos, BoundsMin, VoxSize );
	const float EncodedDist = BrickAtlas.Sample( GlobalTrilinearClampedSampler, UVW );
	const float SampleDist = DecodeDistance( EncodedDist, Diagonal );
	return SampleDist;
}

// https://iquilezles.org/articles/normalsSDF/
float3 GetAtlasNormal( float3 Pos, float3 BoundsMin )
{
	// Note that the normals are reversed on the inside of geometry (so for negative distances)
	// This should be fine, as those should never be visible anyway
	const float2 K = float2( 1, -1 );
	return normalize( K.xyy * GetAtlasDistClamped( Pos + (K.xyy * DerivativeH), BoundsMin ) +
					  K.yyx * GetAtlasDistClamped( Pos + (K.yyx * DerivativeH), BoundsMin ) +
					  K.yxy * GetAtlasDistClamped( Pos + (K.yxy * DerivativeH), BoundsMin ) +
					  K.xxx * GetAtlasDistClamped( Pos + (K.xxx * DerivativeH), BoundsMin ) );
}
float3 GetTerrainNormal( float3 Pos, FTerrainParams Params )
{
	// TODO: wrong?
	const float2 K = float2( 1, -1 );
	return normalize( K.xyy * DistFn::FBM( Pos + (K.xyy * DerivativeH), Params, UnitScale ) +
					  K.yyx * DistFn::FBM( Pos + (K.yyx * DerivativeH), Params, UnitScale ) +
					  K.yxy * DistFn::FBM( Pos + (K.yxy * DerivativeH), Params, UnitScale ) +
					  K.xxx * DistFn::FBM( Pos + (K.xxx * DerivativeH), Params, UnitScale ) );
}
float3 GetNormal( float3 Pos )
{
	const float2 K = float2( 1, -1 );
	return normalize( K.xyy * MapScene( Pos + (K.xyy * DerivativeH) ) +
					  K.yyx * MapScene( Pos + (K.yyx * DerivativeH) ) +
					  K.yxy * MapScene( Pos + (K.yxy * DerivativeH) ) +
					  K.xxx * MapScene( Pos + (K.xxx * DerivativeH) ) );
}

bool SphereTraceFBM( inout FRay Ray, out float3 Normal )
{
	float DistTravelled = 0.0;
	FTerrainParams Params = GetTerrainParams();
	for (uint Step = 0; Step < 128; ++Step)
	{
		float ClosestDist = DistFn::FBM( Ray.GetPosAt( DistTravelled ), Params, UnitScale );
		DistTravelled += ClosestDist;
		if (DistTravelled > Ray.RelativeMaxT) { break; }
		if (ClosestDist < SurfaceEpsilon)
		{
			Ray.SetHitT( DistTravelled );
			Normal = GetTerrainNormal( Ray.GetHitPos(), Params );
			return true;
		}
	}
	return false;

	const float PlaneZ = 0.0;
	const float HeightAbovePlane = Ray.GetPos().z - PlaneZ;
	const bool AbovePlane = HeightAbovePlane >= 0.0;
	if ((AbovePlane && Ray.Dir.z >= 0.0) || (!AbovePlane && Ray.Dir.z <= 0.0)) { return false; }
	
	const float ClosingRateT = -Ray.Dir.z;
	const float IntersectT = HeightAbovePlane / ClosingRateT;

	if (IntersectT <= Ray.RelativeMaxT) { Ray.SetHitT( IntersectT ); }
	return Ray.bHit;

	// TODO: also have a parameter that is multiplied with the 'k' every octave

	// for loop (stepping)
		// set initial distance based on plane (aka y value in grid space)
		// for loop (octaves)
			// find distance to closest sphere (use SDF repetition)
			// clip layer through intersection using max() or smax()
}

