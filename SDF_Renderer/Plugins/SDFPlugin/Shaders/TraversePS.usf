#define ENABLE_BRUTE_FORCE_SPHERE_TRACING 0

// Shader bindings
Texture3D<float> BrickAtlas;
SamplerState BrickSampler;
float3 PtrGridPos;
float VoxSize;
float UnitScale;

float SampleDistClamped( float3 Pos, float3 BoundsMin )
{
	const float Diagonal = GetDiagonal( VoxSize );
	const float3 UVW = WorldPosToAtlasUVW( Pos, BoundsMin, VoxSize );
	const float EncodedDist = BrickAtlas.Sample( GlobalTrilinearClampedSampler, UVW );
	const float SampleDist = DecodeDistance( EncodedDist, Diagonal );
	return SampleDist;
}

float3 GetNormal( float3 Pos, float3 BoundsMin )
{
	const float H = 4e-4 * UnitScale; // TODO: also check elsewhere
	const float2 K = float2( 1, -1 );
	return normalize( K.xyy * SampleDistClamped( Pos + (K.xyy * H), BoundsMin ) +
					  K.yyx * SampleDistClamped( Pos + (K.yyx * H), BoundsMin ) +
					  K.yxy * SampleDistClamped( Pos + (K.yxy * H), BoundsMin ) +
					  K.xxx * SampleDistClamped( Pos + (K.xxx * H), BoundsMin ) );
}

