// Pointer Grid DDA
bool TraceGrid( inout FRay Ray )
{
	// TODO:
	const float Epsilon = SurfaceEpsilon * UnitScale;
	const float BrickSize = GetBrickSize( VoxSize );
	const FAABB GridAABB = AABB::PtrGrid( PtrGridPos, BrickSize );
	const float Diagonal = GetDiagonal( VoxSize );

	// Setup
	Ray.AdvanceOrigin();
	FDDA DDA = FDDA::Init( Ray, GridAABB.Min, BrickSize );

	// TODO: idkkk
	// Step in brick space
	//DDA.ScaleUnitSize( 1.0 / BrickSize );

	// Initial sample
	if (DDA.IsValidCell( PtrGridSize, Ray.MaxT ))
	{
		if (IsBrickAllocated( GridCellToGridIdx( DDA.CellCoord ) ))
		{
			// Edge case, might start inside any point within a brick
			//return true;
		}
	}

	// Should be safe
	while (true)
	{
		if (! DDA.TryStep( PtrGridSize, Ray.MaxT )) { return false; }
		uint GridIdx = GridCellToGridIdx( DDA.CellCoord );
		if (IsBrickAllocated( GridIdx ))
		{
			DDA.FindNextAxis(); // TODO: make more efficient
			const float DistInsideBrick = DDA.TMax[DDA.Axis];

			float TempT = DDA.T;
			uint i = 0;
			while (TempT < DistInsideBrick && i < 32)
			{
				const float3 UVW = WorldPosToAtlasUVW( Ray.GetPosAt( TempT ), GridAABB.Min, VoxSize );
				const float EncodedDist = BrickAtlas.Sample( GlobalTrilinearClampedSampler, UVW );
				const float SampleDist = DecodeDistance( EncodedDist, Diagonal );
				if (SampleDist < Epsilon)
				{
					Ray.Advance( TempT );
					return true;
				}
				TempT += SampleDist;
				i++;
			}

			//const float3 WorldPos = Ray.GetPosAt( DDA.T );
			//const float3 LocalGridPos = (WorldPos - PtrGridPos) / BrickSize;
			//const float3 LocalBrickPos = (LocalGridPos - DDA.CellCoord) * VoxelResolution;
			//
			//BrickIdxToAtlasCell( PtrGrid[GridIdx] )

			return true;
		}
	}
}

bool SphereTraceScene( inout FRay Ray, out uint EditHitIdx )
{
	const float Epsilon = SurfaceEpsilon * UnitScale;

	// Step through the scene
	for (uint Step = 0; Step < 64; ++Step)
	{
		// For each step, go over each SDF
		float ClosestDist = Infinity;
		for (uint EditIdx = 0; EditIdx < NumEdits; ++EditIdx)
		{
			// Evaluate the distance to the SDF
			const FSDFEdit Edit = SDFEdits[EditIdx];
			const float3 LocalRayPos = Ray.GetPos() - Edit.Pos;
			const float Dist = abs( DistFn::SphereOrigin( Edit, LocalRayPos ) );
			if (Dist < ClosestDist)
			{
				ClosestDist = Dist;
				EditHitIdx = EditIdx;
			}
		}

		// Stop stepping if we hit a surface (or are close enough to one)
		if (ClosestDist < Epsilon) { return true; }

		// Step
		Ray.Advance( ClosestDist );
	}

	// No intersections found
	return false;
}

void TraversePS(
	float4 InPosition : SV_POSITION,
	out float4 OutSceneColor : SV_Target0, // SceneColor (emissive)
	out float4 OutGBufferA : SV_Target1, // World normal
	out float4 OutGBufferB : SV_Target2, // Metallic/spec/rough/shadingmodel
	out float4 OutGBufferC : SV_Target3, // Basecolor + AO
	out float4 OutGBufferD : SV_Target4, // Custom data
	out float OutDepth : SV_DEPTH ) // Depth
{
	// Screen UV
	const float2 ViewportUV = (InPosition.xy - View.ViewRectMin.xy) * View.ViewSizeAndInvSize.zw;
	const float2 NDC = ViewportUV * float2( 2, -2 ) + float2( -1, 1 );

	// Ray setup
	const float4 TranslatedWorldPosH = mul( float4( NDC, 0.5, 1 ), View.ClipToTranslatedWorld );
	const float3 Dir = normalize( TranslatedWorldPosH.xyz / TranslatedWorldPosH.w );
	const float3 Origin = View.ViewOriginHigh * UnitScale; // Convert unit size
	FRay Ray = FRay::Create( Origin, Dir );

#if ENABLE_BRUTE_FORCE_SPHERE_TRACING
	// Sphere trace
	// Discard this fragment if we don't hit anything, keep whatever was already in the GBuffer
	uint EditHitIdx;
	if (! SphereTraceScene( Ray, EditHitIdx )) { discard; }
	// Calculate output data
	const FSDFEdit Edit = SDFEdits[EditHitIdx];
	const float3 Normal = GetSphereNormal( Edit, RayPos );
#else
	if (! TraceGrid( Ray )) { discard; }
	const float3 Normal = float3(1,0,0);
#endif

	// Convert unit size
	const float3 RayPos = Ray.GetPos();
	float ViewZ = mul( float4( (RayPos - Ray.Origin) / UnitScale, 1.0 ), View.TranslatedWorldToView ).z;
	OutDepth = ConvertToDeviceZ( ViewZ );

	FGBufferData GBuffer = (FGBufferData)0;
	GBuffer.BaseColor = (0.6).xxx;
	GBuffer.WorldNormal = Normal;
	GBuffer.Metallic = 0.0;
	GBuffer.Specular = 0.5;
	GBuffer.Roughness = 0.6;
	GBuffer.PerObjectGBufferData = 0.0; // 0 means we don't have distance or height field for this mesh
	GBuffer.SelectiveOutputMask = 0; // No selective output (we don't need this)
	GBuffer.GBufferAO = 1.0; // No occlusion
	GBuffer.PrecomputedShadowFactors = 1.0; // no shadowing
	GBuffer.ShadingModelID = SHADINGMODELID_DEFAULT_LIT; // Normal lighting

	// Write to the packed GBuffer channels
	float4 GA, GB, GC, GD, GE, GV;
	EncodeGBuffer( GBuffer, GA, GB, GC, GD, GE, GV );
	OutSceneColor = (0).xxxx;
	OutGBufferA = GA;
	OutGBufferB = GB;
	OutGBufferC = GC;
	OutGBufferD = GD;
	// Uncomment to add functionality for clear coat and velocity if needed
	//OutTarget5 = GE;
	//OutTarget6 = GV;
}