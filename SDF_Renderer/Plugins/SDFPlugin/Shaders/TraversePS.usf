		if (IsBrickAllocated( DDA.CellCoord ))
		{
			// Edge case, might start inside any point within a brick
			//return true;
#if 1
			DDA.FindNextAxis(); // TODO: make more efficient
			const float DistInsideBrick = min( DDA.TMax[DDA.Axis], Ray.RelativeMaxT );

			float TempT = DDA.T;
			uint i = 0;
			while (TempT < DistInsideBrick)
			{
				const float3 UVW = WorldPosToAtlasUVW( Ray.GetPosAt( TempT ), GridAABB.Min, VoxSize );
				const float EncodedDist = BrickAtlas.Sample( BrickSampler, UVW );
				const float SampleDist = DecodeDistance( EncodedDist, Diagonal );
				if (SampleDist < SurfaceEpsilon)
				{
					Ray.SetHitT( TempT );
					Normal = GetAtlasNormal( Ray.GetHitPos(), GridAABB.Min );
					return true;
				}
				TempT += SampleDist;
				i++;
			}
#endif
		}
	}

	// Should be safe
	while (true)
	{
		if (! DDA.TryStep( PtrGridSize, Ray.RelativeMaxT )) { return false; }
		uint GridIdx = GridCellToGridIdx( DDA.CellCoord );
		if (IsBrickAllocated( GridIdx ))
		{
			DDA.FindNextAxis(); // TODO: make more efficient
			const float DistInsideBrick = min( DDA.TMax[DDA.Axis], Ray.RelativeMaxT );

			float TempT = DDA.T;
			uint i = 0;
			while (TempT < DistInsideBrick)
			{
				const float3 UVW = WorldPosToAtlasUVW( Ray.GetPosAt( TempT ), GridAABB.Min, VoxSize );
				const float EncodedDist = BrickAtlas.Sample( BrickSampler, UVW );
				const float SampleDist = DecodeDistance( EncodedDist, Diagonal );
				if (SampleDist < SurfaceEpsilon)
				{
					Ray.SetHitT( TempT );
					Normal = GetAtlasNormal( Ray.GetHitPos(), GridAABB.Min );
					return true;
				}
				TempT += SampleDist;
				i++;
			}
		}
	}
}

bool TraceScene( inout FRay Ray, out float3 Normal, out float3 Albedo )
{
	// Terrain
	if (SphereTraceFBM( Ray, Normal ))
	{
		const float Height = Ray.GetHitPos().z;
		if (Height < 35.0 * UnitScale) { Albedo = float3(0.1, 0.1, 0.5); }
		else if (Height < 37.0 * UnitScale) { Albedo = float3(0.8, 0.6, 0.2); }
		else if (Height < 55.0 * UnitScale) { Albedo = float3(0.2, 0.5, 0.1); }
		else { Albedo = float3(0.75, 0.75, 0.8); }
	}

	// Brute-force sphere tracing
	if (bBruteForceSphereTracing > 0)
    {
		float DistTravelled = 0.0;
		for (uint Step = 0; Step < 256; ++Step)
		{
			float ClosestDist = MapScene( Ray.GetPosAt( DistTravelled ) );
			DistTravelled += ClosestDist;
			if (DistTravelled > Ray.RelativeMaxT) { break; }
			if (ClosestDist < SurfaceEpsilon)
			{
				Ray.SetHitT( DistTravelled );
				Normal = GetNormal( Ray.GetHitPos() );
				Albedo = (0.4).xxx;
				break;
			}
		}
    }
	// Brickmap traversal
	else
    {
	    const float BrickSize = GetBrickSize( VoxSize );
	    const FAABB GridAABB = AABB::PtrGrid( PtrGridPos, BrickSize );
	    if (MoveRayToAABB( GridAABB, Ray, UnitScale ))
	    {
			if (TracePtrGrid( Ray, Normal ))
			{
				Albedo = float3(0.8, 0.1, 0.1);
			}
	    }
    }
	return Ray.bHit;
}

void TraversePS(
	float4 InPosition : SV_POSITION,
	out float4 OutSceneColor : SV_Target0, // SceneColor (emissive)
	out float4 OutGBufferA : SV_Target1, // World normal
	out float4 OutGBufferB : SV_Target2, // Metallic/spec/rough/shadingmodel
	out float4 OutGBufferC : SV_Target3, // Basecolor + AO
	out float4 OutGBufferD : SV_Target4, // Custom data
	out float OutDepth : SV_DEPTH ) // Depth
{
	// Screen UV
	const float2 ViewportUV = (InPosition.xy - View.ViewRectMin.xy) * View.ViewSizeAndInvSize.zw;
	const float2 NDC = ViewportUV * float2( 2, -2 ) + float2( -1, 1 );

	// Ray setup
	const float4 TranslatedWorldPosH = mul( float4( NDC, 0.5, 1 ), View.ClipToTranslatedWorld );
	const float3 Dir = normalize( TranslatedWorldPosH.xyz / TranslatedWorldPosH.w );
	FRay Ray = FRay::Create( View.ViewOriginHigh * UnitScale, Dir ); // Convert unit size
	
	// Trace
	float3 Normal, Albedo;
	if (! TraceScene( Ray, Normal, Albedo )) { discard; }

	// Convert unit size
    const float ViewZ = (Ray.GetHitT() / UnitScale) * dot( Dir, View.ViewForward.xyz );
    OutDepth = ConvertToDeviceZ( ViewZ );

	FGBufferData GBuffer = (FGBufferData)0;
	GBuffer.BaseColor = Albedo;
	GBuffer.WorldNormal = Normal;
	GBuffer.Metallic = 0.0;
	GBuffer.Specular = 0.5;
	GBuffer.Roughness = 0.6;
	GBuffer.PerObjectGBufferData = 0.0; // 0 means we don't have distance or height field for this mesh
	GBuffer.SelectiveOutputMask = 0; // No selective output (we don't need this)
	GBuffer.GBufferAO = 1.0; // No occlusion
	GBuffer.PrecomputedShadowFactors = 1.0; // no shadowing
	GBuffer.ShadingModelID = SHADINGMODELID_DEFAULT_LIT; // Normal lighting

	// Write to the packed GBuffer channels
	float4 GA, GB, GC, GD, GE, GV;
	EncodeGBuffer( GBuffer, GA, GB, GC, GD, GE, GV );
	OutSceneColor = (0).xxxx;
	OutGBufferA = GA;
	OutGBufferB = GB;
	OutGBufferC = GC;
	OutGBufferD = GD;
	// Uncomment to add functionality for clear coat and velocity if needed
	//OutTarget5 = GE;
	//OutTarget6 = GV;
}