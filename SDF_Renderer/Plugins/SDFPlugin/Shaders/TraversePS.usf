// Shader bindings
Texture3D<float> BrickAtlas;
SamplerState BrickSampler;
float3 PtrGridPos;
float VoxSize;
float SurfaceEpsilon;
float DerivativeH;
float UnitScale;

// TODO: make this clamped
// TODO: if outside of bounds, return Diagonal? Unsure
float GetAtlasDistClamped( float3 Pos, float3 BoundsMin )
{
	const float Diagonal = GetDiagonal( VoxSize );
	const float3 UVW = WorldPosToAtlasUVW( Pos, BoundsMin, VoxSize );
	const float EncodedDist = BrickAtlas.Sample( GlobalTrilinearClampedSampler, UVW );
	const float SampleDist = DecodeDistance( EncodedDist, Diagonal );
	return SampleDist;
}

// https://iquilezles.org/articles/normalsSDF/
float3 GetAtlasNormal( float3 Pos, float3 BoundsMin )
{
	// Note that the normals are reversed on the inside of geometry (so for negative distances)
	// This should be fine, as those should never be visible anyway
	const float2 K = float2( 1, -1 );
	return normalize( K.xyy * GetAtlasDistClamped( Pos + (K.xyy * DerivativeH), BoundsMin ) +
					  K.yyx * GetAtlasDistClamped( Pos + (K.yyx * DerivativeH), BoundsMin ) +
					  K.yxy * GetAtlasDistClamped( Pos + (K.yxy * DerivativeH), BoundsMin ) +
					  K.xxx * GetAtlasDistClamped( Pos + (K.xxx * DerivativeH), BoundsMin ) );
}
float3 GetNormal( float3 Pos )
{
	const float2 K = float2( 1, -1 );
	return normalize( K.xyy * MapScene( Pos + (K.xyy * DerivativeH) ) +
					  K.yyx * MapScene( Pos + (K.yyx * DerivativeH) ) +
					  K.yxy * MapScene( Pos + (K.yxy * DerivativeH) ) +
					  K.xxx * MapScene( Pos + (K.xxx * DerivativeH) ) );
}

