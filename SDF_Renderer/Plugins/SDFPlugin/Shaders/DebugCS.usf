#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"
#include "Common.ush"
#include "BrickmapCommon.ush"

Texture2D OriginalSceneColor;
Texture2D DepthTex;
SCREEN_PASS_TEXTURE_VIEWPORT( SceneColorViewport )
RWTexture2D<float4> Output;

float3 PtrGridPos;
float VoxSize;
float UnitScale;
uint DbgVisMaxBricks;
float DbgVisBlendFactor;

float NumBrickHits( FRay Ray, float3 BoundsMin, float BrickSize )
{
	// DDA setup
	FDDA DDA = FDDA::Init( Ray, BoundsMin, BrickSize );

	// Initial sample
	uint NumHits = 0;
	if (DDA.IsValidCell( PtrGridSize, Ray.RelativeMaxT ))
	{
		if (IsBrickAllocated( DDA.CellCoord ))
		{
			// Intersection found
			if (++NumHits >= DbgVisMaxBricks) { NumHits / (float)DbgVisMaxBricks; }
		}
	}

	// Should be safe
	while (true)
	{
		if (! DDA.TryStep( PtrGridSize, Ray.RelativeMaxT )) { break; }
		if (IsBrickAllocated( DDA.CellCoord ))
		{
			// Intersection found
			if (++NumHits >= DbgVisMaxBricks) { break; }
		}
	}

	return NumHits / (float)DbgVisMaxBricks;
}

// [CREDITS] https://www.shadertoy.com/view/XtGGzG
float3 InfernoQuintic( float Normalized )
{
	Normalized = saturate( Normalized );
	float4 x1 = float4( 1.0, Normalized, Normalized * Normalized, Normalized * Normalized * Normalized ); // 1 x x2 x3
	float4 x2 = x1 * x1.w * Normalized; // x4 x5 x6 x7
	return saturate( float3(
		dot( x1.xyzw, float4( -0.027780558, +1.228188385, +0.278906882, +3.892783760 ) ) + dot( x2.xy, float2( -8.490712758, +4.069046086 ) ),
		dot( x1.xyzw, float4( +0.014065206, +0.015360518, +1.605395918, -4.821108251 ) ) + dot( x2.xy, float2( +8.389314011, -4.193858954 ) ),
		dot( x1.xyzw, float4( -0.019628385, +3.122510347, -5.893222355, +2.798380308 ) ) + dot( x2.xy, float2( -3.608884658, +4.324996022 ) ) ) );
}

[numthreads(8, 8, 1)]
void DebugCS( uint2 DispatchThreadId : SV_DispatchThreadID )
{
	if (any( DispatchThreadId >= SceneColorViewport_ViewportMax ))
	{
		return;
	}

	// ...
	ResolvedView = ResolveView();

	// Screen UV
	const uint2 SampleCoord = SceneColorViewport_ViewportMin + DispatchThreadId;
	const float2 SampleUV = ((float2)SampleCoord + 0.5) * SceneColorViewport_ExtentInverse;
	const float2 ViewportUV = (DispatchThreadId + 0.5) * SceneColorViewport_ViewportSizeInverse;
	const float2 NDC = ViewportUV * float2( 2, -2 ) + float2( -1, 1 );
	
	// Ray setup
	const float4 TranslatedWorldPosH = mul( float4( NDC, 0.5, 1 ), View.ClipToTranslatedWorld );
	const float3 Dir = normalize( TranslatedWorldPosH.xyz / TranslatedWorldPosH.w );
    const float2 DepthBufferUV = (View.ViewRectMin.xy + ViewportUV * View.ViewSizeAndInvSize.xy) * View.BufferSizeAndInvSize.zw;
    const float DeviceZ = DepthTex.SampleLevel(GlobalPointClampedSampler, DepthBufferUV, 0).r;
    const float Depth = ConvertFromDeviceZ(DeviceZ) / dot(Dir, ResolvedView.ViewForward.xyz);
	FRay Ray = FRay::Create( View.ViewOriginHigh * UnitScale, Dir, Depth * UnitScale ); // Convert unit size

	// Grid AABB check
	float NumHits = 0;
	const float BrickSize = GetBrickSize( VoxSize );
	const FAABB GridAABB = AABB::PtrGrid( PtrGridPos, BrickSize );
	if (MoveRayToAABB( GridAABB, Ray, UnitScale ))
	{
		// Grid DDA
		NumHits = NumBrickHits( Ray, GridAABB.Min, BrickSize );
	}

	// Compute output color
	const float4 OriginalColor = OriginalSceneColor.SampleLevel( GlobalPointClampedSampler, SampleUV, 0 );
	float3 NewColor = (NumHits > 0) ? lerp( OriginalColor, InfernoQuintic( NumHits ), DbgVisBlendFactor ) : OriginalColor;
    if (WorldPosToGridCell(Ray.GetPos(), GridAABB.Min, BrickSize).z == 37)
    {
        NewColor = 1.0;
    }
	Output[SampleCoord] = float4( NewColor, OriginalColor.w );
}