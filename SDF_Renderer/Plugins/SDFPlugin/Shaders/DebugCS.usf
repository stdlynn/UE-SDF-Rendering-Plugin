Texture2D OriginalSceneColor;
Texture2D DepthTex;
SCREEN_PASS_TEXTURE_VIEWPORT(SceneColorViewport)
RWTexture2D<float4> Output;

float3 PtrGridPos;
float VoxSize;

#define USE_DIST_INSTEAD_OF_HITS 0

// TODO: change this to work in the right space
float NumBrickHits( FRay Ray, float3 BoundsMin, float BrickSize )
{
    // [CREDITS] DDA algorithm from http://www.cs.yorku.ca/~amana/research/grid.pdf
    int3 GridCellCoord = int3(floor((Ray.Pos - BoundsMin) / BrickSize)); // The ray origin in pointer-grid space
    const int3 CellStep = int3(sign(Ray.Dir)); // The step direction for each axis (-1, 0, or 1), in pointer-grid space
    const float3 TDelta = abs(BrickSize * Ray.InvDir); // The step size (to move the length of a voxel along a certain axis) for each axis, in world space
    const int3 NextCellCoord = GridCellCoord + (CellStep + 1) / 2; // The next cell to be hit (on a certain axis) for each axis, in pointer-grid space
    const float3 NextCellCoordWorldSpace = float3(NextCellCoord) * BrickSize + BoundsMin; // The next cells to be hit (on a certain axis) for each axis, in world space
    float3 TMax = (NextCellCoordWorldSpace - Ray.Pos) * Ray.InvDir; // The distance to the next cell for each axis, in world space

    // Handle ray direction being zero
    for (uint Axis = 0; Axis < 3; ++Axis)
    {
        if (Ray.Dir[Axis] == 0)
        {
            TMax[Axis] = 1e38;
        }
    }
    
	// Take the first step (into the grid)
    // Necessary for finding the initial axis to move on
    uint Axis = TMax.x < TMax.y
			        ? TMax.x < TMax.z
			             ? 0
			             : 2
			        : TMax.y < TMax.z
			        	    ? 1
			        	    : 2;
	//GridCellCoord[Axis] += CellStep[Axis];
    //TMax[Axis] += TDelta[Axis];
    float CurrT = 0.;//TMax[Axis];
    //if (GridCellCoord[Axis] < 0 || GridCellCoord[Axis] >= PtrGridSize[Axis] || CurrT > Ray.T) { return 0.0; }

    // Should be safe
    float TotalT = 0; // Total distance travelled within allocated bricks
    uint NumHits = 0;
    while (true)
    {
        // Check if a brick is present in the current cell
        if (IsBrickAllocated( GridCellToGridIdx( GridCellCoord ) ))
        {
            // Intersection found
            NumHits++;
            TotalT += TMax[Axis] - CurrT;
        }

        // Find the axis on which we are the closest to the next cell
        Axis = TMax.x < TMax.y
		        ? TMax.x < TMax.z
		             ? 0
		             : 2
		        : TMax.y < TMax.z
			            ? 1
			            : 2;

        // Store the distance travelled AFTER we step to the next cell
        CurrT = TMax[Axis];

        // Step to the next cell
        GridCellCoord[Axis] += CellStep[Axis];
        TMax[Axis] += TDelta[Axis];

        // Voxel object and ray bounds check
        if (GridCellCoord[Axis] < 0 || GridCellCoord[Axis] >= PtrGridSize[Axis] || CurrT > Ray.T)
        {
            break;
        }
    }

#if USE_DIST_INSTEAD_OF_HITS
	return TotalT / 70.0;
#else
    return NumHits / 14.0;
#endif
}

// [CREDITS] https://www.shadertoy.com/view/XtGGzG
float3 InfernoQuintic(float Normalized)
{
    Normalized = saturate(Normalized);
    float4 x1 = float4(1.0, Normalized, Normalized * Normalized, Normalized * Normalized * Normalized); // 1 x x2 x3
    float4 x2 = x1 * x1.w * Normalized; // x4 x5 x6 x7
    return saturate(float3(
		dot(x1.xyzw, float4(-0.027780558, +1.228188385, +0.278906882, +3.892783760)) + dot(x2.xy, float2(-8.490712758, +4.069046086)),
		dot(x1.xyzw, float4(+0.014065206, +0.015360518, +1.605395918, -4.821108251)) + dot(x2.xy, float2(+8.389314011, -4.193858954)),
		dot(x1.xyzw, float4(-0.019628385, +3.122510347, -5.893222355, +2.798380308)) + dot(x2.xy, float2(-3.608884658, +4.324996022))));
}
float3 MagmaQuintic( float Normalized )
{
    Normalized = saturate(Normalized);
    float4 X1 = float4(1.0, Normalized, Normalized * Normalized, Normalized * Normalized * Normalized); // 1 x x2 x3
    float4 X2 = X1 * X1.w * Normalized; // x4 x5 x6 x7
    return saturate(float3(
		dot(X1.xyzw, float4(-0.023226960, +1.087154378, -0.109964741, +6.333665763)) + dot(X2.xy, float2(-11.640596589, +5.337625354)),
		dot(X1.xyzw, float4(+0.010680993, +0.176613780, +1.638227448, -6.743522237)) + dot(X2.xy, float2(+11.426396979, -5.523236379)),
		dot(X1.xyzw, float4(-0.008260782, +2.244286052, +3.005587601, -24.279769818)) + dot(X2.xy, float2(+32.484310068, -12.688259703))));
}

[numthreads(8, 8, 1)]
void DebugCS(uint2 DispatchThreadId : SV_DispatchThreadID)
{
    if (any(DispatchThreadId >= SceneColorViewport_ViewportMax))
    {
        return;
    }

    // Screen UV
	const float2 ViewportUV = (DispatchThreadId + 0.5) * SceneColorViewport_ViewportSizeInverse;
	const float2 NDC = ViewportUV * float2(2, -2) + float2(-1, 1);

    // Ray setup
	const float4 TranslatedWorldPosH = mul(float4(NDC, 0.5, 1), View.ClipToTranslatedWorld);
    const float3 Dir = normalize( TranslatedWorldPosH.xyz / TranslatedWorldPosH.w );
    const uint2 DepthCoord = DispatchThreadId + SceneColorViewport_ViewportMin;
    const float DepthSample = ConvertFromDeviceZ( DepthTex[DepthCoord].r );
	const float Depth = DepthSample / dot( Dir, ResolvedView.ViewForward.xyz );
	FRay Ray = FRay::Create( View.ViewOriginHigh, Dir, Depth ); // TODO: fix depth
	
	// Grid AABB check
    float AABBHitT;
	float NumHits = 0;
    const float BrickSize = GetBrickSize( VoxSize );
    const FAABB GridAABB = AABB::PtrGrid( PtrGridPos, BrickSize );
	if (IntersectAABB( GridAABB, Ray, AABBHitT ))
    {
		// Grid DDA
        AABBHitT -= AABBEpsilon;
        Ray.Advance( AABBHitT );
        NumHits = NumBrickHits( Ray, GridAABB.Min, BrickSize );
    }
    
	// Compute output color
	const float2 SampleUV = (float2(SceneColorViewport_ViewportMin) + DispatchThreadId + 0.5) * SceneColorViewport_ExtentInverse;
    const float4 OriginalColor = OriginalSceneColor.SampleLevel(GlobalPointClampedSampler, SampleUV, 0);
    const float3 NewColor = (NumHits > 0) ? lerp( OriginalColor, InfernoQuintic(NumHits), 0.6 ) : OriginalColor;
    Output[SceneColorViewport_ViewportMin + DispatchThreadId] = float4(NewColor, OriginalColor.w);
}