// TODO Probably not a good idea to keep these above the includes
RWTexture3D<float> BrickAtlas;
RWBuffer<uint> PtrGrid;
RWBuffer<uint> BrickAllocCounter; // 0: next free brick in atlas, 1: size of deallocated list

#include "/Engine/Public/Platform.ush"
#include "BrickmapCommon.ush"
#include "Common.ush"

StructuredBuffer<FSDFEdit> SDFEdits;
uint NumEdits;

Buffer<uint> BrickList;
uint NumUpdatedBricks;

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void BuildBrickmapCS(uint3 GroupID : SV_GroupID, uint3 GroupThreadID : SV_GroupThreadID)
{
	if (GroupID.x >= NumUpdatedBricks)
	{
		return;
	}
	if (all(GroupThreadID == 0))
	{
		bDeallocateFlag = true;
	}

	// Sync so no thread can set the flag to false before it's set to true
	GroupMemoryBarrierWithGroupSync();

	const uint GridIdx = BrickList[GroupID.x];
	const uint3 GridCell = GridIdxToGridCell(GridIdx);
	const float3 WorldPos = GridCellToWorldPos(GridCell) + float3(GroupThreadID);
	
	float Nearest = MaxRayDist;
	for (uint EditIdx = 0; EditIdx < NumEdits; EditIdx++)
	{
		const FSDFEdit Edit = SDFEdits[EditIdx];
		Nearest = min(Nearest, SDFSphere(WorldPos, Edit.Pos, Edit.Radius));
	}
	if (abs(Nearest) <= sqrt(3))
	{
		bDeallocateFlag = false;
	}

	GroupMemoryBarrierWithGroupSync();

	// Deallocate
	if (all(GroupThreadID == 0) && bDeallocateFlag && PtrGrid[GridIdx] != 0xFFFFFFFFu)
	{
		uint Next;
		InterlockedAdd(BrickAllocCounter[1], 1, Next);
		// Here
		DeallocatedList[Next] = PtrGrid[GridIdx];
		PtrGrid[GridIdx] = 0xFFFFFFFFu;
	}

	if (!bDeallocateFlag)
	{
		if (all(GroupThreadID == 0))
		{
			uint AtlasIdx = PtrGrid[GridIdx];

			// If not allocated, allocate
			if (AtlasIdx == 0xFFFFFFFFu)
			{
				uint DeallocatedSize = BrickAllocCounter[1];

				// Atomically claim atlas index from deallocated list
				[allow_uav_condition]
				while (DeallocatedSize != 0)
				{
					uint Original;
					InterlockedCompareExchange(BrickAllocCounter[1], DeallocatedSize, DeallocatedSize - 1, Original);
					if (Original == DeallocatedSize)
					{
						AtlasIdx = DeallocatedList[DeallocatedSize - 1];
						break;
					}

					DeallocatedSize = Original;
				}

				// If failed (none free), claim next brick in atlas
				if (AtlasIdx == 0xFFFFFFFFu)
				{
					InterlockedAdd(BrickAllocCounter[0], 1, AtlasIdx);
				}

				PtrGrid[GridIdx] = AtlasIdx;
			}

			AtlasIdxShared = AtlasIdx;
		}

		GroupMemoryBarrierWithGroupSync();

		const uint3 AtlasPoint = uint3(IdxToAtlasCell(AtlasIdxShared) * BrickResolution, 0) + GroupThreadID;
		const float Encoded = clamp(Nearest * InvDiagonal, -1.0, 1.0) * 0.5 + 0.5;
		BrickAtlas[AtlasPoint] = Encoded;
	}
}

Buffer<uint> FreeList;
// NumFree is CounterFree
RWBuffer<uint> DeallocatedList;
// NumDeallocated is CounterPush

groupshared bool bOccupiedShared;
groupshared uint AtlasIdxShared;

static const uint CounterAlloc = 0; // Next free unallocated brick in atlas
static const uint CounterFree  = 1; // How many bricks are in the FreeList
static const uint CounterPop   = 2; // Reset each frame. Pop pointer into FreeList
static const uint CounterPush  = 3; // Reset each frame. Push pointer into DeallocatedList

static const uint Empty = 0xFFFFFFFFu;

