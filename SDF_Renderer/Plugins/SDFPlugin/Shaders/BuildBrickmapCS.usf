// TODO Probably not a good idea to keep these above the includes
RWTexture3D<float> BrickAtlas;
RWBuffer<uint> PtrGrid;
RWBuffer<uint> BrickAllocCounter;

#include "/Engine/Public/Platform.ush"
#include "BrickmapCommon.ush"
#include "Common.ush"

StructuredBuffer<FSDFEdit> SDFEdits;
uint NumEdits;
float3 PtrGridPos;
float VoxSize;

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void BuildBrickmapCS(uint3 ThreadId : SV_DispatchThreadID)
{
	//if (any(ThreadId >= AtlasSize))
	//    return;
	if (any(ThreadId != 0))
	{
		return;
	}

	const float BrickSize = GetBrickSize( VoxSize );
	const FAABB GridAABB = AABB::PtrGrid( PtrGridPos, BrickSize );

	for (int Idx = 0; Idx < NumEdits; Idx++)
	{
		const FSDFEdit Edit = SDFEdits[Idx];
		const FAABB SphereAABB = AABB::Sphere(Edit);

		const int3 MinGridCellUnbounded = WorldPosToGridCell( SphereAABB.Min, GridAABB.Min, BrickSize );
		const int3 MaxGridCellUnbounded = WorldPosToGridCell( SphereAABB.Max, GridAABB.Min, BrickSize ) + 1;
		const uint3 MinGridCell = (uint3)clamp( MinGridCellUnbounded, int3( 0, 0, 0 ), (int3)MaxGridIdx );
		const uint3 MaxGridCell = (uint3)clamp( MaxGridCellUnbounded, int3( 0, 0, 0 ), (int3)MaxGridIdx );
		const uint3 NumCoveredBricks = MaxGridCell - MinGridCell;
		
		uint3 GridCellOffset;
		for (GridCellOffset.z = 0; GridCellOffset.z < NumCoveredBricks.z; GridCellOffset.z++) {
		for (GridCellOffset.y = 0; GridCellOffset.y < NumCoveredBricks.y; GridCellOffset.y++) {
		for (GridCellOffset.x = 0; GridCellOffset.x < NumCoveredBricks.x; GridCellOffset.x++)
		{
			const uint3 GridCell = MinGridCell + GridCellOffset;
			AllocateSafe( GridCell );
			PopulateBrickSDF( Edit, GridCell );
		}}}
	}
}