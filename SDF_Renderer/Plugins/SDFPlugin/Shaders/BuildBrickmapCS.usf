// TODO Probably not a good idea to keep these above the includes
RWTexture3D<float> BrickAtlas;
RWBuffer<uint> PtrGrid;
RWBuffer<uint> BrickAllocCounter;

#include "/Engine/Public/Platform.ush"
#include "BrickmapCommon.ush"
#include "Common.ush"

StructuredBuffer<FSDFEdit> SDFEdits;
uint NumEdits;
Buffer<uint> BrickList;
uint NumUpdatedBricks;

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void BuildBrickmapCS(uint3 GroupID : SV_GroupID, uint3 GroupThreadID : SV_GroupThreadID)
{
	if (GroupID.x >= NumUpdatedBricks) return;

	const uint GridIdx = BrickList[GroupID.x];
	const uint3 GridCell = GridIdxToGridCell(GridIdx);

	// Allocate brick
	if (all(GroupThreadID == 0) && PtrGrid[GridIdx] == 0xFFFFFFFFu)
    {
        uint Next;
        InterlockedAdd(BrickAllocCounter[0], 1, Next);
        PtrGrid[GridIdx] = Next;
    }
    AllMemoryBarrierWithGroupSync();

	const uint Idx = PtrGrid[GridCellToGridIdx(GridCell)];
	const uint3 AtlasPoint = uint3(IdxToAtlasCell(Idx) * BrickResolution, 0) + GroupThreadID;
	const float3 WorldPos = GridCellToWorldPos(GridCell) + float3(GroupThreadID);

	float Nearest = MaxRayDist;
	for (uint EditIdx = 0; EditIdx < NumEdits; EditIdx++)
	{
	    const FSDFEdit Edit = SDFEdits[EditIdx];
	    Nearest = min(Nearest, SDFSphere(WorldPos, Edit.Pos, Edit.Radius));
	}

	// Distance is stored so that 1.0 is the length of a voxel diagonal (=1.732)
	static const float InvDiagonal = 1.0 / sqrt(3.0);
	const float Encoded = clamp(Nearest * InvDiagonal, -1.0, 1.0) * 0.5 + 0.5;

	const float PrevValue = BrickAtlas[AtlasPoint];
	BrickAtlas[AtlasPoint] = min(Encoded, PrevValue);
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void TheoreticalAllocator(uint3 GroupID : SV_GroupID, uint3 GroupThreadID : SV_GroupThreadID)
{
	if (GroupID.x >= NumUpdatedBricks) return;

	// For every Edit:
	//		store closest distance

	// If within distance:
	//		set deallocation flag false

	// Barrier

	// If deallocation and thread is 0:
	//		Atomically append atlas index to deallocated list
	//		Set PtrGrid to 0xffffffff
	
	// if not deallocate:
	//		if thread 0:
	//			Atomically claim atlas index from deallocated list
	//			If failed (none free):
	//				Claim next BrickAllocCounter in brick atlas
	//			Write claimed value into PtrGrid
	//		Barrier
	//		Write distance value into our voxel within brick pointed to by PtrGrid

	// Allocate brick
	if (all(GroupThreadID == 0) && PtrGrid[GridIdx] == 0xFFFFFFFFu)
    {
        uint Next;
        InterlockedAdd(BrickAllocCounter[0], 1, Next);
        PtrGrid[GridIdx] = Next;
    }
    AllMemoryBarrierWithGroupSync();
}