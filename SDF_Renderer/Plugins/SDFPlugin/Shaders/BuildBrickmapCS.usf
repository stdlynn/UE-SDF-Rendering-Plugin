// TODO Probably not a good idea to keep these above the includes
RWTexture3D<float> BrickAtlas;
RWBuffer<uint> PtrGrid;

#include "/Engine/Public/Platform.ush"
#include "BrickmapCommon.ush"
#include "Common.ush"

StructuredBuffer<FSDFEdit> SDFEdits;
uint NumEdits;

Buffer<uint> UpdateList;
uint NumUpdated;
RWBuffer<uint> FreedList;
RWBuffer<uint> DeallocatedList;

RWBuffer<uint> BrickAllocCounters;
static const uint CounterAtlas		= 0; // Next free unallocated brick in atlas
static const uint CounterClaimed	= 1; // Reset each frame. Pop pointer into FreedList
static const uint CounterDealloced	= 2; // Reset each frame. Push pointer into DeallocatedList
static const uint NumFreed			= 3; // How many bricks are in the FreedList (read-only during build pass)

groupshared bool bContainsSurfaceShared;
groupshared uint AtlasIdxShared;

static const uint Empty = 0xFFFFFFFFu;

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void BuildBrickmapCS(uint3 GroupID : SV_GroupID, uint3 GroupThreadID : SV_GroupThreadID)
{
	if (GroupID.x >= NumUpdated) return;

	if (all(GroupThreadID == 0))
	{
		bContainsSurfaceShared = false;
	}

	GroupMemoryBarrierWithGroupSync();

	const uint GridIdx = UpdateList[GroupID.x];
	const uint3 GridCell = GridIdxToGridCell(GridIdx);
	const float3 WorldPos = GridCellToWorldPos(GridCell) + float3(GroupThreadID);
	uint AtlasIdx = PtrGrid[GridIdx];

	float Closest = MaxRayDist;
	for (uint EditIdx = 0; EditIdx < NumEdits; EditIdx++)
	{
		const FSDFEdit Edit = SDFEdits[EditIdx];
		Closest = min(Closest, SDFSphere(WorldPos, Edit.Pos, Edit.Radius));
	}
	if (abs(Closest) <= Diagonal)
	{
		bContainsSurfaceShared = true;
	}

	GroupMemoryBarrierWithGroupSync();

	const bool bDeallocate = !bContainsSurfaceShared;

	if (all(GroupThreadID == 0))
	{
		if (bDeallocate)
		{
            if (AtlasIdx != Empty)
            {
				// Deallocate
				uint PrevDealloc;
				InterlockedAdd(BrickAllocCounters[CounterDealloced], 1, PrevDealloc);
				DeallocatedList[PrevDealloc] = AtlasIdx;
				PtrGrid[GridIdx] = Empty;
				AtlasIdx = Empty;
            }
		}
		else if (AtlasIdx == Empty)
		{
			// Allocate
			uint NumFree = BrickAllocCounters[NumFreed];
			uint PrevClaimed;
			InterlockedAdd(BrickAllocCounters[CounterClaimed], 1, PrevClaimed);
			if (PrevClaimed < NumFree)
			{
				// Allocate from FreedList
				AtlasIdx = FreedList[NumFree - PrevClaimed - 1];
			}
			else
			{
				// Allocate from Atlas
				InterlockedAdd(BrickAllocCounters[CounterAtlas], 1, AtlasIdx);
			}
            PtrGrid[GridIdx] = AtlasIdx;
        }

		AtlasIdxShared = AtlasIdx;
	}

	GroupMemoryBarrierWithGroupSync();

	AtlasIdx = AtlasIdxShared;
	if (AtlasIdx == Empty) return;

	uint3 AtlasPoint = uint3(IdxToAtlasCell(AtlasIdxShared) * BrickResolution, 0) + GroupThreadID;
	BrickAtlas[AtlasPoint] = EncodeDistance(Closest);
}

[numthreads(64, 1, 1)]
void TransferDeallocatedCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
	uint NumFree = BrickAllocCounters[NumFreed];
	uint NumClaimed = min(BrickAllocCounters[CounterClaimed], NumFree);
	uint NumDeallocated = BrickAllocCounters[CounterDealloced];
	uint NumCarried = NumFree - NumClaimed;

	uint Idx = DispatchThreadID.x;
	if(Idx < NumDeallocated)
	{
		FreedList[NumCarried + Idx] = DeallocatedList[Idx];
	}
}

[numthreads(1, 1, 1)]
void ResetCountersCS()
{
	uint NumFree = BrickAllocCounters[NumFreed];
	uint NumClaimed = min(BrickAllocCounters[CounterClaimed], NumFree);
	uint NumDeallocated = BrickAllocCounters[CounterDealloced];

	BrickAllocCounters[NumFreed] = NumFree - NumClaimed + NumDeallocated;
	BrickAllocCounters[CounterClaimed] = 0;
	BrickAllocCounters[CounterDealloced] = 0;
}

