#pragma once

#include "/Engine/Public/Platform.ush"

static const float Infinity = asfloat( 0x7F7FFFFF );
static const float AABBEpsilon = 5e-3;

enum EOperation : uint
{
	Union = 0,
	Subtract = 1
};

enum EPrimitive : uint
{
	Sphere = 0,
	Line = 1,
	Box = 2
};

struct FSDFEdit
{
	float3 Pos;
	uint Flags; // bits 0-1: primitive, 2: operation, 3: bSmooths
	float4 Data0; // Per-primitive data
    float4 Data1; // Per-primitive data
	float Smoothing;
	uint ID;
	uint Padding[2];

	EPrimitive GetPrimitive() { return (EPrimitive)(Flags & 0b11); }
	float GetSphereRadius() { return Data0.x; }
	float3 GetLinePosB() { return Data0.xyz; }
	float GetLineRadius() { return Data0.w; }
	float3 GetBoxHalfExtent() { return Data0.xyz; }
	float4 GetBoxQuat() { return Data1.xyzw; }
	float4 GetBoxRounding() { return Data0.w; }
 	EOperation GetSDFOperation() { return (EOperation)( (Flags >> 2) & 0b1 ); }
	bool GetSDFSmooths() { return Flags & 0b1000; }
};

// Shader bindings
StructuredBuffer<FSDFEdit> SDFEdits;
uint NumEdits;

struct FRay
{
	static FRay Create( float3 Pos, float3 Dir, float MaxT = Infinity )
	{
		FRay Ray;
		Ray.Origin = Pos;
		Ray.Dir = Dir;
		Ray.InvDir = 1.0 / Dir;
		Ray.T = 0.0;
		Ray.RelativeMaxT = MaxT;
		Ray.RelativeHitT = Infinity;
		Ray.bHit = false;
		return Ray;
	}

	void Advance( float Dist )
	{
		T += Dist;
		RelativeMaxT -= Dist;
		RelativeHitT -= Dist;
	}

	// 'Dist' relative to 'T'
	void SetMaxT( float Dist )
	{
		RelativeMaxT = Dist;
	}

	// 'Dist' relative to 'T'
	void SetHitT( float Dist )
	{
		RelativeHitT = Dist;
		RelativeMaxT = RelativeHitT;
		bHit = true;
	}

	// 'Dist' relative to 'T'
	float3 GetPosAt( float Dist ) { return Origin + (Dir * (T + Dist)); }
	float3 GetPos() { return GetPosAt( 0.0 ); }
	float3 GetHitPos() { return GetPosAt( RelativeHitT ); }
	float GetMaxT() { return T + RelativeMaxT; }
	float GetHitT() { return T + RelativeHitT; }

	// Const
	float3 Origin;
	float3 Dir;
	float3 InvDir;

	// Mutable
	float T;
	float RelativeMaxT;
	float RelativeHitT;
	bool bHit;
};

// [CREDITS] DDA algorithm from http://www.cs.yorku.ca/~amana/research/grid.pdf
struct FDDA
{
	static FDDA Init( FRay Ray, float3 BoundsMin, float CellSize )
	{
		FDDA DDA;
		const float3 Pos = Ray.GetPos();
		DDA.CellCoord = int3( floor( (Pos - BoundsMin) / CellSize ) );
		DDA.CellStep = int3( sign( Ray.Dir ) );
		DDA.TDelta = abs( CellSize * Ray.InvDir );
		// The next cell to be hit (on a certain axis) for each axis, in grid space
		const int3 NextCellCoord = DDA.CellCoord + (DDA.CellStep + 1) / 2;
		const float3 NextCellCoordWorldSpace = float3( NextCellCoord ) * CellSize + BoundsMin;
		DDA.TMax = (NextCellCoordWorldSpace - Pos) * Ray.InvDir;
		for (uint Axis = 0; Axis < 3; ++Axis)
		{
			// Handle ray direction being zero
			if (Ray.Dir[Axis] == 0) { DDA.TMax[Axis] = Infinity; }
		}
		DDA.Axis = 0;
		DDA.T = 0.0;
		return DDA;
	}

	// Step the ray
	bool TryStep( uint3 GridSize, float RayMaxT )
	{
		FindNextAxis();

		// Step to the next cell
		T = TMax[Axis];
		CellCoord[Axis] += CellStep[Axis];
		TMax[Axis] += TDelta[Axis];

		return IsValidCell( GridSize, RayMaxT );
	}

	// Find the axis on which we are the closest to the next cell
	void FindNextAxis()
	{
		Axis = TMax.x < TMax.y
				   ? TMax.x < TMax.z
						 ? 0
						 : 2
				   : TMax.y < TMax.z
						 ? 1
						 : 2;
	}

	// Grid and ray bounds check
	bool IsValidCell( uint3 GridSize, float RayMaxT )
	{
		return !(CellCoord[Axis] < 0 || CellCoord[Axis] >= GridSize[Axis] || T > RayMaxT);
	}

	int3 CellCoord; // The ray position in grid space
	int3 CellStep; // The step direction for each axis (-1, 0, or 1), in grid space
	float3 TDelta; // The step size (to move the length of a cell along a certain axis) for each axis, in world space
	float3 TMax; // The distance to the next cell for each axis, in world space

	uint Axis;
	float T;
};

struct FAABB
{
	float3 Min;
	float3 Max;
};

// Returns true if there is an intersection
// If true, hit_t is the intersection time
bool IntersectAABB( FAABB Bounds, FRay Ray, out float TNear, out float TFar )
{
	// Relative to 'Ray.T'
	const float3 TToMin = (Bounds.Min - Ray.GetPos()) * Ray.InvDir;
	const float3 TToMax = (Bounds.Max - Ray.GetPos()) * Ray.InvDir;
	const float3 TMin = min( TToMin, TToMax );
	const float3 TMax = max( TToMin, TToMax );
	TNear = max( max3( TMin.x, TMin.y, TMin.z ), 0.0 ); // 0.0 because relative to 'Ray.T'
	TFar = min( min3( TMax.x, TMax.y, TMax.z ), Ray.GetMaxT() );

	return TNear <= TFar;
}

// Set 'Ray.T' and 'Ray.RelativeMaxT'
bool MoveRayToAABB( FAABB Bounds, inout FRay Ray, float UnitScale )
{
	float AABBHitT, AABBOutT;
	if (IntersectAABB( Bounds, Ray, AABBHitT, AABBOutT ))
	{
		const float Epsilon = AABBEpsilon * UnitScale;
		if (AABBHitT > 0.0) { AABBHitT += Epsilon; }
		Ray.SetMaxT( AABBOutT );
		Ray.Advance( AABBHitT );
		return true;
	}
	return false;
}

// Distance functions
// from https://iquilezles.org/articles/distfunctions/
namespace DistFn
{
    float3 RotatePoint(float3 Pos, float4 Quat)
    {
        Quat.xyz *= -1.0;
        float3 t = 2.0 * cross(Quat.xyz, Pos);
        return Pos + Quat.w * t + cross(Quat.xyz, t);
    }

	float Sphere( FSDFEdit SDF, float3 Pos )
	{
		return length( Pos - SDF.Pos ) - SDF.GetSphereRadius();
	}

	float Line( FSDFEdit SDF, float3 Pos )
	{
		float3 PA = Pos - SDF.Pos;
		float3 BA = SDF.GetLinePosB();
		float H = clamp( dot(PA, BA) / dot(BA, BA), 0.0, 1.0 );	
		return length( PA - BA * H ) - SDF.GetLineRadius();
	}

	float Box( FSDFEdit SDF, float3 Pos )
	{
        float Rounding = SDF.GetBoxRounding();
        Pos = RotatePoint(Pos, SDF.GetBoxQuat());
        float3 HalfExtent = SDF.GetBoxHalfExtent() - Rounding;
		float3 Q = abs(Pos - SDF.Pos) - HalfExtent;
        return length(max(Q, 0.0)) + min(max(Q.x, max(Q.y, Q.z)), 0.0) - Rounding;
    }

	float SphereOrigin( FSDFEdit SDF, float3 Pos )
	{
		return length( Pos ) - SDF.GetSphereRadius();
	}

	float LineOrigin( FSDFEdit SDF, float3 Pos )
	{
		float3 BA = SDF.GetLinePosB();
		float H = clamp( dot(Pos, BA) / dot(BA, BA), 0.0, 1.0 );	
		return length( Pos - BA * H ) - SDF.GetLineRadius();
	}

	float BoxOrigin( FSDFEdit SDF, float3 Pos )
	{
        float Rounding = SDF.GetBoxRounding();
        Pos = RotatePoint(Pos, SDF.GetBoxQuat());
		float3 HalfExtent = SDF.GetBoxHalfExtent() - Rounding;
		float3 Q = abs(Pos) - HalfExtent;
		return length(max(Q, 0.0)) + min(max(Q.x, max(Q.y, Q.z)), 0.0) - Rounding;
	}

	float Dist( FSDFEdit SDF, float3 Pos )
	{
		EPrimitive Prim = SDF.GetPrimitive();
		if ( Prim == EPrimitive::Sphere ) { return Sphere( SDF, Pos ); }
		if ( Prim == EPrimitive::Line ) { return Line( SDF, Pos ); }
		return Box( SDF, Pos );
	}

	float DistOrigin( FSDFEdit SDF, float3 Pos )
	{
		EPrimitive Prim = SDF.GetPrimitive();
		if ( Prim == EPrimitive::Sphere ) { return SphereOrigin( SDF, Pos ); }
		if ( Prim == EPrimitive::Line ) { return LineOrigin( SDF, Pos ); }
		return BoxOrigin( SDF, Pos );
	}
} // SDF

// Bounding boxes
// From https://iquilezles.org/articles/bboxes3d/
namespace AABB
{
	FAABB Sphere( FSDFEdit SDF )
	{
		const float Radius = SDF.GetSphereRadius();

		FAABB Bounds;
		Bounds.Min = SDF.Pos - Radius;
		Bounds.Max = SDF.Pos + Radius;
		return Bounds;
	}

	FAABB Line( FSDFEdit SDF )
	{
		const float3 PosB = SDF.GetLinePosB();
		const float Radius = SDF.GetLineRadius();

		FAABB Bounds;
		Bounds.Min = min(SDF.Pos, SDF.Pos + PosB) - Radius;
		Bounds.Max = max(SDF.Pos, SDF.Pos + PosB) + Radius;
		return Bounds;
	}

	FAABB Box( FSDFEdit SDF )
	{
		const float3 HalfExtent = SDF.GetBoxHalfExtent();
        const float4 Quat = SDF.GetBoxQuat();

        float xx = Quat.x * Quat.x;
		float yy = Quat.y * Quat.y;
		float zz = Quat.z * Quat.z;
        float xy = Quat.x * Quat.y;
		float xz = Quat.x * Quat.z;
		float yz = Quat.y * Quat.z;
        float wx = Quat.w * Quat.x;
        float wy = Quat.w * Quat.y;
		float wz = Quat.w * Quat.z;

        float3 Row0 = float3(1.0 - 2.0 * (yy + zz), 2.0 * (xy - wz), 2.0 * (xz + wy));
        float3 Row1 = float3(2.0 * (xy + wz), 1.0 - 2.0 * (xx + zz), 2.0 * (yz - wx));
        float3 Row2 = float3(2.0 * (xz - wy), 2.0 * (yz + wx), 1.0 - 2.0 * (xx + yy));

        float3 E = float3(dot(abs(Row0), HalfExtent),
						  dot(abs(Row1), HalfExtent),
						  dot(abs(Row2), HalfExtent));

        FAABB Bounds;
        Bounds.Min = SDF.Pos - E;
        Bounds.Max = SDF.Pos + E;
		return Bounds;
	}
} // AABB

bool IsPointInsideAABB( FAABB Bounds, float3 Pos )
{
	return all( Pos >= Bounds.Min ) && all( Pos <= Bounds.Max );
}
// https://iquilezles.org/articles/normalsSDF/
float3 GetSphereNormal( FSDFEdit SDF, float3 Pos )
{
	// Avoid precision issues by evaluating the SDF at (0, 0, 0)
	Pos -= SDF.Pos;
	SDF.Pos = (0).xxx;

	// Note that the normals are reversed on the inside of geometry (so for negative distances)
	// This should be fine, as those should never be visible anyway
	const float H = 4e-4; // magic value for now, read linked article for details
	const float2 K = float2( 1, -1 );
	return normalize( K.xyy * DistFn::SphereOrigin( SDF, Pos + (K.xyy * H) ) +
					  K.yyx * DistFn::SphereOrigin( SDF, Pos + (K.yyx * H) ) +
					  K.yxy * DistFn::SphereOrigin( SDF, Pos + (K.yxy * H) ) +
					  K.xxx * DistFn::SphereOrigin( SDF, Pos + (K.xxx * H) ) );
}

// [CREDIT] https://iquilezles.org/articles/distfunctions/
float OpUnion( float a, float b )
{
    return min(a,b);
}
float OpSubtract( float a, float b )
{
    return max(-a,b);
}

float OpSmoothUnion( float a, float b, float k )
{
    k *= 4.0;
    float h = max(k-abs(a-b),0.0);
    return min(a, b) - h*h*0.25/k;
}
float OpSmoothIntersect( float a, float b, float k )
{
	return -OpSmoothUnion(-a,-b,k);
}
float OpSmoothSubtract( float a, float b, float k )
{
    return -OpSmoothUnion(a,-b,k);
}

float MapScene( float3 Pos )
{
	float ClosestDist = Infinity;

	for (uint EditIdx = 0; EditIdx < NumEdits; ++EditIdx)
	{
		const FSDFEdit Edit = SDFEdits[EditIdx];
		EPrimitive Prim = Edit.GetPrimitive();
		EOperation Op = Edit.GetSDFOperation();
		bool bSmooth = Edit.GetSDFSmooths();
		// Evaluate the distance to the SDF
		const float Dist = DistFn::DistOrigin( Edit, Pos - Edit.Pos );
		if (bSmooth)
		{
			if (Op == Union)
			{
				ClosestDist = OpSmoothUnion(Dist, ClosestDist, Edit.Smoothing);
			}
			else if (Op == Subtract)
			{
				ClosestDist = OpSmoothSubtract(Dist, ClosestDist, Edit.Smoothing);
			}
		}
		else
		{
			if (Op == Union)
			{
				ClosestDist = OpUnion(Dist, ClosestDist);
			}
			else if (Op == Subtract)
			{
				ClosestDist = OpSubtract(Dist, ClosestDist);
			}
		}
	}

	return ClosestDist;
}