#pragma once

#include "/Engine/Public/Platform.ush"

static const float UnitSize = 0.01;

static const float Infinity = asfloat( 0x7F7FFFFF );
static const float MaxRayDist = 10e3;
static const float SurfaceEpsilon = 5e-4;
static const float AABBEpsilon = 5e-4;

struct FSDFEdit
{
    float3 Pos;
    float Radius;
    uint Idx;
    uint Padding[3];
};

struct FRay
{
	static FRay Create( float3 Pos, float3 Dir )
	{
		FRay Ray;
        Ray.Pos = Pos;
        Ray.Dir = Dir;
        Ray.InvDir = 1.0 / Dir;
        Ray.T = MaxRayDist;
        return Ray;
	}

    float3 Pos;
    float3 Dir;
    float3 InvDir;
	float T;
};

struct FAABB
{
	float3 Min;
	float3 Max;
};

// Returns true if there is an intersection
// If true, hit_t is the intersection time
bool IntersectAABB( FAABB Bounds, FRay Ray, out float HitT )
{
    const float3 TToMin = (Bounds.Min - Ray.Pos) * Ray.InvDir;
    const float3 TToMax = (Bounds.Max - Ray.Pos) * Ray.InvDir;
    const float3 TMin = min( TToMin, TToMax );
    const float3 TMax = max( TToMin, TToMax );
    const float TNear = max( max3( TMin.x, TMin.y, TMin.z ), 0 );
    const float TFar = min( min3( TMax.x, TMax.y, TMax.z ), Infinity );

    HitT = TNear;
    return TNear <= TFar;
}

// Distance functions
namespace DistFn
{
    float Sphere( FSDFEdit SDF, float3 Pos )
    {
	    return length( Pos - SDF.Pos ) - SDF.Radius;
    }
} // SDF

// Bounding boxes
namespace AABB
{
	FAABB Sphere( FSDFEdit SDF )
	{
        FAABB Bounds;
		Bounds.Min = SDF.Pos - SDF.Radius;
		Bounds.Max = SDF.Pos + SDF.Radius;
        return Bounds;
	}
} // AABB

// https://iquilezles.org/articles/normalsSDF/
float3 GetSphereNormal( FSDFEdit SDF, float3 Pos )
{
	const float H = 0.004; // magic value for now, read linked article for details
	const float2 K = float2(1, -1);
	return normalize(K.xyy * DistFn::Sphere( SDF, Pos + K.xyy * H ) +
					 K.yyx * DistFn::Sphere( SDF, Pos + K.yyx * H ) +
					 K.yxy * DistFn::Sphere( SDF, Pos + K.yxy * H ) +
					 K.xxx * DistFn::Sphere( SDF, Pos + K.xxx * H ));
}