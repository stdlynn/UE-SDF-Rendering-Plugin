#pragma once

#include "/Engine/Public/Platform.ush"

static const float Infinity = asfloat( 0x7F7FFFFF );
static const float SurfaceEpsilon = 1e-1;
static const float AABBEpsilon = 5e-3;

enum EOperation : uint
{
	Union = 0,
	Subtract = 1
};

struct FSDFEdit
{
	float3 Pos;
	float Radius;
	uint Flags; // bit 0: operation, 1: bSmooths
	float Smoothing;
	uint ID;
	uint Padding[1];

	EOperation GetSDFOperation()
	{
		return (EOperation)(Flags & 0b1);
	}

	bool GetSDFSmooths()
	{
		return Flags & 0b10;
	}
};

// Shader bindings
StructuredBuffer<FSDFEdit> SDFEdits;
uint NumEdits;

struct FRay
{
	static FRay Create( float3 Pos, float3 Dir, float MaxT = Infinity )
	{
		FRay Ray;
		Ray.Origin = Pos;
		Ray.Dir = Dir;
		Ray.InvDir = 1.0 / Dir;
		Ray.T = 0.0;
		Ray.MaxT = MaxT;
		return Ray;
	}

	void Advance( float Dist )
	{
		T += Dist;
	}

	void AdvanceOrigin()
	{
		Origin += Dir * T;
		MaxT -= T;
		T = 0.0;
	}

	float3 GetPosAt( float Dist )
	{
		return Origin + (Dir * Dist);
	}

	float3 GetPos()
	{
		return GetPosAt( T );
	}

	float3 Origin;
	float3 Dir;
	float3 InvDir;
	float T;
	float MaxT;
};

// [CREDITS] DDA algorithm from http://www.cs.yorku.ca/~amana/research/grid.pdf
struct FDDA
{
	static FDDA Init( FRay Ray, float3 BoundsMin, float CellSize )
	{
		FDDA DDA;
		DDA.CellCoord = int3( floor( (Ray.Origin - BoundsMin) / CellSize ) );
		DDA.CellStep = int3( sign( Ray.Dir ) );
		DDA.TDelta = abs( CellSize * Ray.InvDir );
		// The next cell to be hit (on a certain axis) for each axis, in grid space
		const int3 NextCellCoord = DDA.CellCoord + (DDA.CellStep + 1) / 2;
		const float3 NextCellCoordWorldSpace = float3( NextCellCoord ) * CellSize + BoundsMin;
		DDA.TMax = (NextCellCoordWorldSpace - Ray.Origin) * Ray.InvDir;
		for (uint Axis = 0; Axis < 3; ++Axis)
		{
			// Handle ray direction being zero
			if (Ray.Dir[Axis] == 0) { DDA.TMax[Axis] = Infinity; }
		}
		DDA.Axis = 0;
		DDA.T = 0.0;
		return DDA;
	}

	void ScaleUnitSize( float Scale )
	{
		TDelta *= Scale;
		TMax *= Scale;
		T *= Scale;
	}

	// Step the ray
	bool TryStep( uint3 GridSize, float RayMaxT )
	{
		FindNextAxis();

		// Step to the next cell
		T = TMax[Axis];
		CellCoord[Axis] += CellStep[Axis];
		TMax[Axis] += TDelta[Axis];

		return IsValidCell( GridSize, RayMaxT );
	}

	// Find the axis on which we are the closest to the next cell
	void FindNextAxis()
	{
		Axis = TMax.x < TMax.y
				   ? TMax.x < TMax.z
						 ? 0
						 : 2
				   : TMax.y < TMax.z
						 ? 1
						 : 2;
	}

	// Grid and ray bounds check
	bool IsValidCell( uint3 GridSize, float RayMaxT )
	{
		return !(CellCoord[Axis] < 0 || CellCoord[Axis] >= GridSize[Axis] || T > RayMaxT);
	}

	int3 CellCoord; // The ray position in grid space
	int3 CellStep; // The step direction for each axis (-1, 0, or 1), in grid space
	float3 TDelta; // The step size (to move the length of a cell along a certain axis) for each axis, in world space
	float3 TMax; // The distance to the next cell for each axis, in world space

	uint Axis;
	float T;
};

struct FAABB
{
	float3 Min;
	float3 Max;
};

// Returns true if there is an intersection
// If true, hit_t is the intersection time
bool IntersectAABB( FAABB Bounds, FRay Ray, out float TNear, out float TFar )
{
	const float3 TToMin = (Bounds.Min - Ray.Origin) * Ray.InvDir;
	const float3 TToMax = (Bounds.Max - Ray.Origin) * Ray.InvDir;
	const float3 TMin = min( TToMin, TToMax );
	const float3 TMax = max( TToMin, TToMax );
	TNear = max( max3( TMin.x, TMin.y, TMin.z ), Ray.T );
	TFar = min( min3( TMax.x, TMax.y, TMax.z ), Ray.MaxT );

	return TNear <= TFar;
}

// Distance functions
namespace DistFn
{
	float Sphere( FSDFEdit SDF, float3 Pos )
	{
		return length( Pos - SDF.Pos ) - SDF.Radius;
	}

	float SphereOrigin( FSDFEdit SDF, float3 Pos )
	{
		return length( Pos ) - SDF.Radius;
	}
} // SDF

// Bounding boxes
namespace AABB
{
	FAABB Sphere( FSDFEdit SDF )
	{
		FAABB Bounds;
		Bounds.Min = SDF.Pos - SDF.Radius;
		Bounds.Max = SDF.Pos + SDF.Radius;
		return Bounds;
	}
} // AABB

bool IsPointInsideAABB( FAABB Bounds, float3 Pos )
{
	return all( Pos >= Bounds.Min ) && all( Pos <= Bounds.Max );
}
// https://iquilezles.org/articles/normalsSDF/
float3 GetSphereNormal( FSDFEdit SDF, float3 Pos )
{
	// Avoid precision issues by evaluating the SDF at (0, 0, 0)
	Pos -= SDF.Pos;
	SDF.Pos = (0).xxx;

	// Note that the normals are reversed on the inside of geometry (so for negative distances)
	// This should be fine, as those should never be visible anyway
	const float H = 4e-4; // magic value for now, read linked article for details
	const float2 K = float2( 1, -1 );
	return normalize( K.xyy * DistFn::SphereOrigin( SDF, Pos + (K.xyy * H) ) +
					  K.yyx * DistFn::SphereOrigin( SDF, Pos + (K.yyx * H) ) +
					  K.yxy * DistFn::SphereOrigin( SDF, Pos + (K.yxy * H) ) +
					  K.xxx * DistFn::SphereOrigin( SDF, Pos + (K.xxx * H) ) );
}

// [CREDIT] https://iquilezles.org/articles/distfunctions/
float OpUnion( float a, float b )
{
    return min(a,b);
}
float OpSubtract( float a, float b )
{
    return max(-a,b);
}

float OpSmoothUnion( float a, float b, float k )
{
    k *= 4.0;
    float h = max(k-abs(a-b),0.0);
    return min(a, b) - h*h*0.25/k;
}
float OpSmoothSubtract( float a, float b, float k )
{
    return -OpSmoothUnion(a,-b,k);
}

float MapScene( float3 Pos )
{
	float ClosestDist = Infinity;

	for (uint EditIdx = 0; EditIdx < NumEdits; ++EditIdx)
	{
		const FSDFEdit Edit = SDFEdits[EditIdx];
		EOperation Op = Edit.GetSDFOperation();
		bool bSmooth = Edit.GetSDFSmooths();
		// Evaluate the distance to the SDF
		const float Dist = DistFn::SphereOrigin( Edit, Pos - Edit.Pos );

		if (bSmooth)
		{
			if (Op == Union)
			{
				ClosestDist = OpSmoothUnion(Dist, ClosestDist, Edit.Smoothing);
			}
			else if (Op == Subtract)
			{
				ClosestDist = OpSmoothSubtract(Dist, ClosestDist, Edit.Smoothing);
			}
		}
		else
		{
			if (Op == Union)
			{
				ClosestDist = OpUnion(Dist, ClosestDist);
			}
			else if (Op == Subtract)
			{
				ClosestDist = OpSubtract(Dist, ClosestDist);
			}
		}
	}

	return ClosestDist;
}