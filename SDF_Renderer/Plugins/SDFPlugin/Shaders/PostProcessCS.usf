#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
//#include "/Engine/Private/Compute.ush"
#include "/Engine/Private/DeferredShadingCommon.ush"
#include "/Engine/Private/SceneTexturesCommon.ush"

float SDFSphere(float3 Point, float3 Center, float Radius)
{
	return length(Point - Center) - Radius;
}

// https://iquilezles.org/articles/normalsSDF/
float3 GetSphereNormal(float3 Point, float3 Center, float Radius)
{
	const float H = 0.004; // magic value for now, read linked article for details
	const float2 K = float2(1, -1);
	return normalize(K.xyy * SDFSphere(Point + K.xyy * H, Center , Radius) + 
					 K.yyx * SDFSphere(Point + K.yyx * H, Center , Radius) + 
					 K.yxy * SDFSphere(Point + K.yxy * H, Center , Radius) + 
					 K.xxx * SDFSphere(Point + K.xxx * H, Center , Radius));
}

void MainPS(
	float4 SvPosition : SV_POSITION,
	out float4 OutSceneColor : SV_Target0, // SceneColor (emissive)
	out float4 OutGBufferA   : SV_Target1, // World normal
	out float4 OutGBufferB   : SV_Target2, // Metallic/spec/rough/shadingmodel
	out float4 OutGBufferC   : SV_Target3, // Basecolor + AO
	out float4 OutGBufferD   : SV_Target4, // Custom data
	out float  OutDepth		 : SV_DEPTH)   // Depth
{
	// UV for GBuffer
	float2 BufferUV = SvPosition.xy * View.BufferSizeAndInvSize.zw;
	// Screen UV
	float2 ViewportUV = (SvPosition.xy - View.ViewRectMin.xy) * View.ViewSizeAndInvSize.zw;
	float2 NDC = ViewportUV * float2(2, -2) + float2(-1, 1);

    float4 TranslatedWorldPosH = mul(float4(NDC, 0.5, 1), View.ClipToTranslatedWorld);
	float3 Direction = normalize(TranslatedWorldPosH.xyz / TranslatedWorldPosH.w);
	float3 Origin = View.ViewOriginHigh;
	float3 RayPosition = Origin;
	float DistanceTraveled = 0.0;

	const float SurfaceEpsilon = 0.01;
	const float MaxDistance = 100000.0;
	const float SphereRadius = 100.0;
	const float3 SphereCenter = float3(0, 0, 0);

	bool bHit = false;
	for (int i = 0; i < 64; i++)
	{
		float ClosestDistance = abs(SDFSphere(RayPosition, SphereCenter, SphereRadius));
		if (ClosestDistance < SurfaceEpsilon)
		{
			bHit = true;
			break;
		}
		RayPosition += Direction * ClosestDistance;
		DistanceTraveled += ClosestDistance;
		if (DistanceTraveled > MaxDistance)
		{
			break;
		}
	}

	if (bHit)
	{
		float3 Normal = GetSphereNormal(RayPosition, SphereCenter, SphereRadius);

		float ViewZ = mul(float4(RayPosition - Origin, 1.0), View.TranslatedWorldToView).z;
		OutDepth = ConvertToDeviceZ(ViewZ);

		FGBufferData GBuffer = (FGBufferData) 0;
		GBuffer.BaseColor = float3(0.6, 0.6, 0.6);
		GBuffer.WorldNormal = Normal;
		GBuffer.Metallic = 0.0;
		GBuffer.Specular = 0.5;
		GBuffer.Roughness = 0.6;
		GBuffer.PerObjectGBufferData = 0.0; // 0 means we don't have distance or height field for this mesh
		GBuffer.SelectiveOutputMask = 0; // No selective output (we don't need this)
		GBuffer.GBufferAO = 1.0; // No occlusion
		GBuffer.PrecomputedShadowFactors = 1.0; // no shadowing
		GBuffer.ShadingModelID = SHADINGMODELID_DEFAULT_LIT; // Normal lighting
		
		// Write to the packed GBuffer channels
		float4 GA, GB, GC, GD, GE, GV;
		EncodeGBuffer(GBuffer, GA, GB, GC, GD, GE, GV);
		OutSceneColor = float4(0,0,0,0);
		OutGBufferA = GA;
		OutGBufferB = GB;
		OutGBufferC = GC;
		OutGBufferD = GD;
		// Uncomment to add functionality for clear coat and velocity if needed
		//OutTarget5 = GE;
		//OutTarget6 = GV;
	}
	else
	{
		// Discard this fragment, keep whatever was already in the GBuffer
		discard;
	}
}