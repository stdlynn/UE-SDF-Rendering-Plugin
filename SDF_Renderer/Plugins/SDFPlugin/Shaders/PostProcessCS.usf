#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/DeferredShadingCommon.ush"
#include "BrickmapCommon.ush"
#include "Common.ush"

struct FGPUSDF
{
    float3 Pos;
    float Radius;
    uint Idx;
};

// Shader bindings
StructuredBuffer<FGPUSDF> SDFEdits;
uint NumEdits;

Texture3D<float> BrickAtlas;
SamplerState BrickSampler;
Buffer<uint> PtrGrid;

void TraversePS(
	float4	   InPosition	 : SV_POSITION,
	out float4 OutSceneColor : SV_Target0, // SceneColor (emissive)
	out float4 OutGBufferA   : SV_Target1, // World normal
	out float4 OutGBufferB   : SV_Target2, // Metallic/spec/rough/shadingmodel
	out float4 OutGBufferC   : SV_Target3, // Basecolor + AO
	out float4 OutGBufferD   : SV_Target4, // Custom data
	out float  OutDepth		 : SV_DEPTH)   // Depth
{
	// Screen UV
	float2 ViewportUV = (InPosition.xy - View.ViewRectMin.xy) * View.ViewSizeAndInvSize.zw;
	float2 NDC = ViewportUV * float2(2, -2) + float2(-1, 1);

	float4 TranslatedWorldPosH = mul(float4(NDC, 0.5, 1), View.ClipToTranslatedWorld);
	float3 Dir = normalize(TranslatedWorldPosH.xyz / TranslatedWorldPosH.w);
	float3 Origin = View.ViewOriginHigh * UnitSize; // Convert unit size
	float3 RayPos = Origin;
	float DistTraveled = 0.0;
	uint PrimitiveHitIdx = 0xFFFFFFFF;

	bool bHit = false;
	for (int Sample = 0; Sample < 32; Sample++)
	{
		float ClosestDist = MaxRayDist;
		for (int PrimitiveIdx = 0; PrimitiveIdx < NumPrimitives; PrimitiveIdx++)
		{
			FPrimitive Primitive = SDFEdits[PrimitiveIdx];
			float Dist = abs(SDFSphere(RayPos, Primitive.Pos, Primitive.Radius));
			if (Dist < ClosestDist)
			{
				ClosestDist = Dist;
				PrimitiveHitIdx = PrimitiveIdx;
			}
		}

		if (ClosestDist < SurfaceEpsilon)
		{
			bHit = true;
			break;
		}
		RayPos += Dir * ClosestDist;
		DistTraveled += ClosestDist;
		if (DistTraveled > MaxRayDist)
		{
			break;
		}
	}

	if (bHit)
	{
		FPrimitive Primitive = SDFEdits[PrimitiveHitIdx];
		float3 Normal = GetSphereNormal(RayPos, Primitive.Pos, Primitive.Radius);

		// Convert unit size
		float ViewZ = mul(float4((RayPos - Origin) / UnitSize, 1.0), View.TranslatedWorldToView).z;
		OutDepth = ConvertToDeviceZ(ViewZ);

		bool bDebugCheck = false;
		//if (BrickAtlas.SampleLevel(BrickSampler, float3(0.0, 0.0, 0.0), 0) >= 0.49) bDebugCheck = true;

		FGBufferData GBuffer = (FGBufferData) 0;
		GBuffer.BaseColor = float3(0.6, 0.6, 0.6);
		GBuffer.WorldNormal = Normal;
		GBuffer.Metallic = 0.0;
		GBuffer.Specular = 0.5;
		GBuffer.Roughness = 0.6;
		GBuffer.PerObjectGBufferData = 0.0; // 0 means we don't have distance or height field for this mesh
		GBuffer.SelectiveOutputMask = 0; // No selective output (we don't need this)
		GBuffer.GBufferAO = 1.0; // No occlusion
		GBuffer.PrecomputedShadowFactors = 1.0; // no shadowing
		GBuffer.ShadingModelID = SHADINGMODELID_DEFAULT_LIT; // Normal lighting
		
		// Write to the packed GBuffer channels
		float4 GA, GB, GC, GD, GE, GV;
		EncodeGBuffer(GBuffer, GA, GB, GC, GD, GE, GV);
		OutSceneColor = float4(100 * bDebugCheck, 0, 0, 0);
		OutGBufferA = GA;
		OutGBufferB = GB;
		OutGBufferC = GC;
		OutGBufferD = GD;
		// Uncomment to add functionality for clear coat and velocity if needed
		//OutTarget5 = GE;
		//OutTarget6 = GV;
	}
	else
	{
		// Discard this fragment, keep whatever was already in the GBuffer
		discard;
	}
}