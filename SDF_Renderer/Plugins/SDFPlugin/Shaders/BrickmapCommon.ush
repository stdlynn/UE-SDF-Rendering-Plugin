#pragma once

#include "/Engine/Public/Platform.ush"
#include "Common.ush"
#include "Terrain.ush"

#ifdef BRICKMAP_WRITE
RWTexture3D<float> BrickAtlas;
RWBuffer<uint> PtrGrid;
#else
Texture3D<float> BrickAtlas;
Buffer<uint> PtrGrid;
#endif

//_______________________________________________________________________
// The numbers below are measured in voxels								|	
//																		|
// WorldPos   |	float3 | inf    | World-space position					|
// GridCell   | uint3  | 0-63   | PtrGrid cell index					|
// AtlasCell  |	uint3  | 0-127  | 3D Brick cell index in Atlas			|
// AtlasUVW   |	float3 | 0-1    | Atlas sample coord (trilinear)		|
// AtlasPoint |	uint3  | *		| Atlas texel coord						|
// AtlasIndex |	uint   | 0-131k	| Atlas buffer index					|
// BrickPoint |	uint3  | 0-7	| Atlas texel coord, local to brick		|
// BrickIdx   |	uint   | 0-16k  | Index to a Brick (stored in PtrGrid)	|
// GridIdx    | uint   | 0-262k | index to a GridCell					|
//																		|
// * (0-127, 0-127, 0-7)												|
//______________________________________________________________________|

static const uint BrickRes = 8;
static const uint VoxRes = BrickRes - 1;

static const uint3 NumAtlasBricks = uint3( 256, 256, 8 );
static const uint3 AtlasSize = NumAtlasBricks * BrickRes;

static const uint3 PtrGridSize = uint3( 256, 256, 64 );
static const uint3 MaxGridIdx = PtrGridSize - 1;

static const uint Empty = 0xFFFFFFFFu;

float EncodeDistance( float Distance, float InvDiagonal )
{
	return clamp( Distance * InvDiagonal, -1.0, 1.0 ) * 0.5 + 0.5;
}
float DecodeDistance( float Distance, float Diagonal )
{
	return (Distance - 0.5) * 2.0 * Diagonal;
}

float GetBrickSize( float VoxSize ) { return VoxSize * VoxRes; }
float GetDiagonal( float VoxSize ) { return (sqrt( 3.0 )) * VoxSize; }

namespace AABB
{
	FAABB PtrGrid( float3 Pos, float BrickSize )
	{
		const float3 HalfExtent = PtrGridSize * BrickSize / 2.0;
		FAABB Bounds;
		Bounds.Min = Pos - HalfExtent;
		Bounds.Max = Pos + HalfExtent;
		return Bounds;
	}
} // AABB

float3 GridCellToWorldPos( int3 GridCell, float3 GridMin, float BrickSize )
{
	return (GridCell * BrickSize) + GridMin;
}

int3 WorldPosToGridCell( float3 WorldPos, float3 GridMin, float BrickSize )
{
	return floor( (WorldPos - GridMin) / BrickSize );
}

uint GridCellToGridIdx( uint3 GridCell )
{
	return GridCell.x
		   + (GridCell.y * PtrGridSize.x)
		   + (GridCell.z * PtrGridSize.x * PtrGridSize.y);
}

uint3 GridIdxToGridCell( uint GridIdx )
{
	const uint Z = GridIdx / (PtrGridSize.x * PtrGridSize.y);
	const uint Intermediate = GridIdx - (Z * PtrGridSize.x * PtrGridSize.y);
	const uint Y = Intermediate / PtrGridSize.x;
	const uint X = Intermediate - (Y * PtrGridSize.x);
	return uint3( X, Y, Z );
}

uint3 BrickIdxToAtlasCell( uint BrickIdx )
{
	const uint Z = BrickIdx / (NumAtlasBricks.x * NumAtlasBricks.y);
	const uint Intermediate = BrickIdx - (Z * NumAtlasBricks.x * NumAtlasBricks.y);
	const uint Y = Intermediate / NumAtlasBricks.x;
	const uint X = Intermediate - (Y * NumAtlasBricks.x);
	return uint3( X, Y, Z );
}

float3 WorldPosToAtlasUVW( float3 WorldPos, float3 GridMin, float VoxSize )
{
	// Find the grid cell
	const float BrickSize = GetBrickSize( VoxSize );
	const uint3 GridCell = WorldPosToGridCell( WorldPos, GridMin, BrickSize );
	
	// Retrieve the atlas cell
	const uint GridIdx = GridCellToGridIdx( GridCell );
	const uint BrickIdx = PtrGrid[GridIdx];
	const uint3 AtlasCell = BrickIdxToAtlasCell( BrickIdx );

	// Find the voxel offset within the brick
	const float3 GridLocalPos = WorldPos - GridMin; // World units [0, GridMax)
	const float3 BrickLocalPos = GridLocalPos - (GridCell * BrickSize); // World units [0, BrickSize)
	const float3 BrickLocalVoxOffset = BrickLocalPos / VoxSize; // Voxel units [0, VoxRes)
	
	// Find the (unnormalized) sample position
	// All in voxel units [0, AtlasSize)
	const uint3 AtlasCellOrigin = AtlasCell * BrickRes;
	const float3 AtlasPoint = AtlasCellOrigin + BrickLocalVoxOffset;

	// The hardware sampling converts our UVW into a TexCoord through 'TexCoord = (UVW * TexSize) - 0.5'
	// So we need to compensate for the offset by doing 'UVW = (TexCoord + 0.5) / TexSize'
	// The offset is added because hardware assumes a texel value represents the texel's center
	// Directly sampling texel N as 'u=N' results in interpolation between 'N-0.5' and 'N+0.5'
	// While sampling 'u=N+0.5' gets you exactly the value stored in texel N
	return (AtlasPoint + 0.5) / AtlasSize;
}

bool IsBrickAllocated( uint Idx ) { return (PtrGrid[Idx] != Empty); }
bool IsBrickAllocated( uint3 GridCell ) { return IsBrickAllocated( GridCellToGridIdx( GridCell ) );}

FSDFMaterial SampleMaterial( float3 Pos )
{
	FSDFMaterial MatBlended = Materials[TerrainMatIdx];
	float TerrainDist = DistFn::FBM( Pos );
	float ClosestDist = TerrainDist;

	for (uint EditIdx = 0; EditIdx < NumEdits; ++EditIdx)
	{
		const FSDFEdit Edit = SDFEdits[EditIdx];
		const EOperation Op = Edit.GetSDFOperation();
		const bool bColorsSubtraction = Edit.GetColorsSubtraction();
		const float Smoothing = Edit.GetSDFSmooths() ? Edit.Smoothing : 0.0;
		// Evaluate the distance to the SDF
		const float Dist = DistFn::DistOrigin(Edit, Pos - Edit.Pos);

		// Blending factor to replace previous material with new one
		// Depends on the difference between the previous and new distance (and operation)
		float Blend = 0.0;

		if (Op == Union)
		{
			if (Smoothing > 0.0)
			{
				// Function derived from derivative of the smoothing function
				Blend = saturate(0.5 + 0.5 * ((ClosestDist - Dist) / (Smoothing * 4.0)));
				ClosestDist = OpSmoothUnion(Dist, ClosestDist, Smoothing);
			}
			else
			{
				// Unsmoothed edits either completely replace or keep the previous material
				Blend = (Dist < ClosestDist) ? 1.0 : 0.0;
				ClosestDist = OpUnion(Dist, ClosestDist);
			}
		}
		else if (Op == Subtract)
		{
			if (bColorsSubtraction)
			{
				// Use the subtractive edit's material to shade the subtracted region
				if (Smoothing > 0.0)
				{
					Blend = saturate(0.5 - 0.5 * (ClosestDist + Dist) / (Smoothing * 4.0));
					ClosestDist = OpSmoothSubtract(Dist, ClosestDist, Smoothing);
				}
				else
				{
					Blend = (-Dist > ClosestDist) ? 1.0 : 0.0;
					ClosestDist = OpSubtract(Dist, ClosestDist);
				}
			}
			else
			{
				// Don't use the subtractive edit's material for shading
				Blend = 0.0;
			}
		}

		// Update the blended material based on the blending factor
		if (Blend > 0.0)
		{
			MatBlended = InterpolateMaterial(MatBlended, Materials[Edit.MatIdx], Blend);
		}
	}

	return MatBlended;
}