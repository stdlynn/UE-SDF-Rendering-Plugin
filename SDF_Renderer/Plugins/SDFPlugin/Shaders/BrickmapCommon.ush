#pragma once

#include "/Engine/Public/Platform.ush"
#include "Common.ush"

//_______________________________________________________________________
// The numbers below are measured in voxels								|	
//																		|
// WorldPos   |	float3 | inf    | World-space position					|
// GridCell   | int3   | 0-63   | PtrGrid cell index					|
// AtlasCell  |	int2   | 0-127  | 2D Brick cell index in Atlas			|
// AtlasUVW   |	float3 | 0-1    | Atlas sample coord (trilinear)		|
// AtlasPoint |	int3   | *		| Atlas texel coord						|
// BrickPoint |	int3   | 0-7	| Atlas texel coord, local to brick		|
// BrickIdx   |	uint   | 0-16k  | Index to a Brick (stored in PtrGrid)	|
// GridIdx    | uint   | 0-262k | index to a GridCell					|
//																		|
// * (0-127, 0-127, 0-7)												|
//______________________________________________________________________|

static const uint BrickResolution = 8;
static const uint VoxelResolution = BrickResolution - 1;

static const uint3 NumAtlasBricks = uint3( 128, 128, 1 ) ;
static const uint3 AtlasSize = NumAtlasBricks * BrickResolution;

static const uint3 PtrGridSize = uint3(64, 64, 64);
static const uint3 MaxGridIdx = PtrGridSize - 1;

float GetBrickSize( float VoxSize )
{
	return VoxSize * VoxelResolution;
}

float GetDiagonal( float VoxSize )
{
	return sqrt(3) * VoxSize;
}

float EncodeDistance(float Distance, float InvDiagonal)
{
	return clamp(Distance * InvDiagonal, -1.0, 1.0) * 0.5 + 0.5;
}

float DecodeDistance(float Distance, float Diagonal)
{
	return (Distance - 0.5) * 2.0 * Diagonal;
}

namespace AABB
{
	FAABB PtrGrid( float3 Pos, float BrickSize )
	{
		const float3 HalfExtent = PtrGridSize * BrickSize / 2.0;
		FAABB Bounds;
		Bounds.Min = Pos - HalfExtent;
		Bounds.Max = Pos + HalfExtent;
        return Bounds;
	}
} // AABB

float3 GridCellToWorldPos( int3 GridCell, float3 GridMin, float BrickSize )
{
	return (GridCell * BrickSize) + GridMin;
}

int3 WorldPosToGridCell( float3 WorldPos, float3 GridMin, float BrickSize )
{
	return floor( (WorldPos - GridMin) / BrickSize );
}

uint GridCellToGridIdx( uint3 GridCell )
{
	return GridCell.x 
		   + (GridCell.y * PtrGridSize.x) 
		   + (GridCell.z * PtrGridSize.x * PtrGridSize.y);
}

uint3 GridIdxToGridCell(uint GridIdx)
{
	const uint Z = GridIdx / (PtrGridSize.x * PtrGridSize.y);
	const uint Intermediate = GridIdx - (Z * PtrGridSize.x * PtrGridSize.y);
	const uint Y = Intermediate / PtrGridSize.x;
	const uint X = Intermediate - (Y * PtrGridSize.x);
	return uint3(X, Y, Z);
}

uint2 BrickIdxToAtlasCell( uint BrickIdx )
{
	const uint Y = BrickIdx / NumAtlasBricks.x;
	return uint2( BrickIdx - (Y * NumAtlasBricks.x), Y );
}

float3 WorldPosToAtlasUVW( float3 WorldPos, float3 GridMin, float VoxSize )
{
	const float BrickSize = GetBrickSize( VoxSize );
	const uint3 GridCell = WorldPosToGridCell( WorldPos, GridMin, BrickSize );
	const uint GridIdx = GridCellToGridIdx( GridCell );
	const uint BrickIdx = PtrGrid[GridIdx];
	const uint2 AtlasCell = BrickIdxToAtlasCell( BrickIdx );
	const float3 BrickPos = float3( AtlasCell * BrickResolution, 0 );
	// TODO: wrong?
	const float3 LocalBrickOffset = ((WorldPos - GridMin) % BrickSize) / VoxSize;
	const float3 LocalBrickPos = BrickPos + LocalBrickOffset;
	return LocalBrickPos / AtlasSize;
}

bool IsBrickAllocated( uint Idx )
{
	return (PtrGrid[Idx] != 0xFFFFFFFF);
}

bool IsBrickAllocated( uint3 GridCell )
{
    return IsBrickAllocated( GridCellToGridIdx( GridCell ) );
}

// Allocate a brick by storing its index in the pointer grid
void Allocate(uint3 GridCell)
{
	uint NextIndex;
	InterlockedAdd(BrickAllocCounter[0], 1, NextIndex);

	PtrGrid[GridCellToGridIdx(GridCell)] = NextIndex;
}

// Allocate a brick, only if this location isn't already allocated
void AllocateSafe(uint3 GridCell)
{
	// TODO: This isn't safe right now (the same ptr grid cell could increment the counter more than once)
	// Won't be an issue when we upload a list of bricks to update
	if (IsBrickAllocated(GridCell)) { return; }

	Allocate(GridCell);
}