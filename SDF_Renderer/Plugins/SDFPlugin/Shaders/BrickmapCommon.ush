#pragma once

#include "/Engine/Public/Platform.ush"
#include "Common.ush"

//________________________________________________________________________
//																		  |	
// GridCell   | uint3  | 0-64   | 3D PtrGrid cell index					  |
// AtlasCell  |	uint2  | 0-128  | 2D Brick cell index in Atlas			  |
// WorldPos   |	float3 | inf    | World-space position					  |
// AtlasPoint |	uint3  | 0-7    | 3D Atlas texel index					  |
// BrickPoint |	uint3  | 0-1024 | Atlas texel, relative to brick's origin |
// AtlasUVW   |	float3 | 0-1    | Sampling coordinates for BrickAtlas	  |
// Idx        |	uint   | 0-16k  | Index to a Brick stored in Ptr Grid	  |
// GridIdx    | uint   | 0-262k | 1D index to sample Ptr Grid			  |
//________________________________________________________________________|


static const uint BrickResolution = 8;
static const uint VoxelResolution = BrickResolution - 1;

static const uint3 NumAtlasBricks = uint3(128, 128, 1);
static const uint3 AtlasSize = NumAtlasBricks * BrickResolution;

static const uint3 PtrGridSize = uint3(64, 64, 64);

bool IsInsideGrid(float3 WorldPos)
{
    return all(WorldPos >= 0) && all(WorldPos < PtrGridSize);
}

float3 GridCellToWorldPos(uint3 GridCell)
{
	return GridCell * VoxelResolution;
}

uint3 WorldPosToGridCell(float3 World)
{
    return uint3(floor(World / VoxelResolution));
}

float3 WorldToAtlasPoint(float3 World)
{
	return World % VoxelResolution;
}

uint GridCellToGridIdx(uint3 GridCell)
{
	return GridCell.x + (GridCell.y * PtrGridSize.x) + (GridCell.z * PtrGridSize.y * PtrGridSize.z);
}

uint2 IdxToAtlasCell(uint Idx)
{
	return uint2(Idx % NumAtlasBricks.x, (Idx / NumAtlasBricks.x) % NumAtlasBricks.y);
}

float3 GetAtlasUVW(uint Idx, float3 World)
{
	uint2 AtlasBrickCell = IdxToAtlasCell(Idx);
	float3 Local = WorldToAtlasPoint(World);
	return (float3(AtlasBrickCell * BrickResolution, 0) + Local) / AtlasSize;
}

float3 WorldToAtlasUVW(float3 World)
{
	uint3 GridCell = WorldPosToGridCell(World);
	uint Idx = PtrGrid[GridCellToGridIdx(GridCell)];
	return GetAtlasUVW(Idx, World);
}

bool IsBrickAllocated(uint Idx)
{
	return (PtrGrid[Idx] != 0xFFFFFFFF);
}

bool IsBrickAllocated(uint3 GridCell)
{
	return (PtrGrid[GridCellToGridIdx(GridCell)] != 0xFFFFFFFF);
}

// Allocate a brick by storing its index in the pointer grid
void Allocate(uint3 GridCell)
{
	uint NextIndex;
	InterlockedAdd(BrickAllocCounter[0], 1, NextIndex);

	PtrGrid[GridCellToGridIdx(GridCell)] = NextIndex;
}

// Allocate a brick, only if this location isn't already allocated
void AllocateSafe(uint3 GridCell)
{
	// TODO: This isn't safe right now (the same ptr grid cell could increment the counter more than once)
	// Won't be an issue when we upload a list of bricks to update
	if (IsBrickAllocated(GridCell))
		return;

	Allocate(GridCell);
}

// Assumes the cell is already allocated
void PopulateBrickSDF(uint3 GridCell, float3 SphereCenter, float SphereRadius)
{
	uint Idx = PtrGrid[GridCellToGridIdx(GridCell)];
	uint3 AtlasCell = uint3(IdxToAtlasCell(Idx), 0) * BrickResolution;

	for (int z = 0; z < BrickResolution; z++) {
	for (int y = 0; y < BrickResolution; y++) {
	for (int x = 0; x < BrickResolution; x++) 
	{
		uint3 AtlasPoint = AtlasCell + uint3(x, y, z);
		float CurDist = BrickAtlas[AtlasPoint];

		float Dist = SDFSphere(AtlasPoint, SphereCenter, SphereRadius) * 0.003;
		if (Dist < CurDist)
		{
			BrickAtlas[AtlasPoint] = abs(Dist);
		}
	}}}
}