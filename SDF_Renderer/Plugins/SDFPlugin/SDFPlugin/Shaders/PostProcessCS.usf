#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"

// SceneColor texture
Texture2D OriginalSceneColor;

// SceneColor Viewport parameters
SCREEN_PASS_TEXTURE_VIEWPORT(SceneColorViewport)

// Output
RWTexture2D<float4> Output;

float sdfSphere( float3 p, float3 c, float r )
{
  return length(p - c) - r;
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void MainCS(uint2 DispatchThreadId : SV_DispatchThreadID)
{
	// Exit if thread is outside the viewport
    if (any(DispatchThreadId >= SceneColorViewport_ViewportMax))
    {
        return;
    }

    float2 viewportUv = (float2(SceneColorViewport_ViewportMin) + (DispatchThreadId + 0.5)) * SceneColorViewport_ExtentInverse;
	float2 ndc = viewportUv * float2(2, -2) + float2(-1, 1);
    
    float4 OriginalColor = OriginalSceneColor.SampleLevel(GlobalPointClampedSampler, viewportUv, 0);
	float3 color = OriginalColor;
	
	float4 p = mul(float4(ndc, 0.5, 1), View.ClipToTranslatedWorld);
    float3 origin = View.ViewOriginHigh;
    float3 direction = normalize(p.xyz / p.w);
    float3 rayPosition = origin;
	float distanceTraveled = 0.0;

	const float surfaceEpsilon = 0.01;
	const float maxDistance = 100000.0;
	const float sphereCenter = float3(0, 0, 0);
	const float sphereRadius = 100.0;

    bool hit = false;
    for (int i = 0; i < 64; i++)
    {
	    float closestDistance = sdfSphere(rayPosition, sphereCenter, sphereRadius);
        distanceTraveled += closestDistance;

		if (closestDistance < surfaceEpsilon) { hit = true; break; }
        rayPosition += direction * closestDistance;
	    if (distanceTraveled > maxDistance) break;
    }

    if (hit)
    {
	    color = float3(1, 0, 0);
    }
    
    // We do have to write *something* here, otherwise we get garbage data from previously used textures.
	Output[SceneColorViewport_ViewportMin + DispatchThreadId] = float4(color, OriginalColor.w);
}
